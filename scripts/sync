#!/usr/bin/env bash
# 설치된 하네스를 이 저장소의 버전으로 갱신한다. 처음 설치는 scripts/init이 이 스크립트를 --init으로 부른다.
# 여러 번 실행해도 결과가 같다. 무엇을 어떻게 다루는지는 docs/template.md에 있다.
set -euo pipefail

usage() {
  cat <<'EOF'
사용법: scripts/sync [--dev] <프로젝트 경로>

  설치된 하네스를 이 저장소의 버전으로 맞춘다. 처음 설치는 scripts/init으로 한다.
  - .harness/project.json의 platforms에 적힌 묶음(packs/<묶음>/)과 공통 파일을 설치한다. 옛 형식 설정은 새 형식으로 옮긴다
  - scripts/harness/, .harness/.gitignore, .claude/rules/harness/는 template과 같게 맞춘다 (지난번에 설치했는데 template에서 사라졌거나 고르지 않은 묶음의 것만 지운다)
  - AGENTS.md는 하네스 관리 블록만 넣거나 바꾸고, 프로젝트 영역은 건드리지 않는다
  - .claude/settings.json에 권한 규칙을 합치고, GitHub 마켓플레이스와 플러그인을 등록한다 (기존 내용 유지. 지난번에 하네스가 넣었는데 이제 없는 규칙만 지운다)
  - .harness/checks.json이 없으면 Claude 세션에서 scripts/harness/setup 안내대로 사용자와 검사를 정하라고 알린다
  - .harness/harness.json에 설치한 하네스 버전을 적는다

  --dev   플러그인을 GitHub 대신 이 저장소 디렉터리에서 읽게 한다 (.claude/settings.local.json).
          하네스를 고치면서 시험장에서 바로 확인할 때 쓴다. 빼고 실행하면 이 설정을 지운다.
EOF
}

mode="sync"   # sync: 이미 설치된 프로젝트만 / init: 처음 설치 (scripts/init이 넘긴다)
dev=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --dev) dev=1 ;;
    --init) mode="init" ;;
    -*) echo "$mode: 알 수 없는 옵션: $1" >&2; usage >&2; exit 2 ;;
    *) break ;;
  esac
  shift
done
if [ $# -ne 1 ]; then
  usage >&2
  exit 2
fi

if ! command -v jq > /dev/null 2>&1; then
  echo "$mode: jq가 필요합니다" >&2
  exit 1
fi
if [ ! -d "$1" ]; then
  echo "$mode: 디렉터리가 없습니다: $1" >&2
  exit 2
fi

target_project_dir="$(cd "$1" && pwd)"                  # 하네스를 설치할 iOS 프로젝트
harness_repo_dir="$(cd "$(dirname "$0")/.." && pwd)"    # 이 스크립트가 있는 하네스 저장소
template_dir="$harness_repo_dir/template"
plugin_json="$harness_repo_dir/plugin/.claude-plugin/plugin.json"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

if [ "$mode" = "init" ] && [ -f "$target_project_dir/.harness/harness.json" ]; then
  echo "init: 이미 설치된 프로젝트입니다. 갱신은 scripts/sync $1" >&2
  exit 2
fi
if [ "$mode" = "sync" ] && [ ! -f "$target_project_dir/.harness/project.json" ]; then
  echo "sync: 하네스가 설치되지 않은 프로젝트입니다. 처음 설치는 scripts/init $1" >&2
  exit 2
fi

# 하네스 버전은 플러그인 버전 하나로 센다. template과 플러그인은 함께 바뀌기 때문이다.
harness_version="$(jq -r .version "$plugin_json")"
# 플러그인 정보의 repository(https://github.com/<owner>/<repo>)가 곧 마켓플레이스 저장소다.
marketplace_repo="${HARNESS_MARKETPLACE_REPO:-$(jq -r .repository "$plugin_json" | sed -E 's#^https://github.com/##; s#\.git$##; s#/$##')}"
marketplace_name="$(jq -r .name "$harness_repo_dir/.claude-plugin/marketplace.json")"
plugin_id="$(jq -r .name "$plugin_json")@$marketplace_name"

# 마지막에 보여줄 목록. 한 줄에 하나씩 쌓는다.
changes=""
todos=""

changed() {
  changes="$changes    $1"$'\n'
}

# 인자를 여러 개 주면 공백으로 이어 한 줄로 만든다.
todo() {
  todos="$todos    $*"$'\n'
}

# template 기준 상대 경로를 받아, 내용이 다를 때만 덮어쓴다. 실행 권한도 원본을 따른다.
install_file() {
  local template_file="$template_dir/$1"
  local project_file="$target_project_dir/$1"

  if [ -f "$project_file" ] && cmp -s "$template_file" "$project_file"; then
    return 0
  fi
  mkdir -p "$(dirname "$project_file")"
  cp -p "$template_file" "$project_file"
  changed "$1"
}

# 새 내용이 기존 파일과 다를 때만 쓴다.
write_if_changed() {
  local dest_file="$1"          # 쓸 곳
  local new_content_file="$2"   # 새 내용이 담긴 임시 파일
  local label="$3"              # 결과에 보일 이름

  if [ -f "$dest_file" ] && cmp -s "$new_content_file" "$dest_file"; then
    return 0
  fi
  mkdir -p "$(dirname "$dest_file")"
  cp "$new_content_file" "$dest_file"
  changed "$label"
}

# --- 1. 프로젝트 설정 파일 -------------------------------------------------------

if [ ! -f "$target_project_dir/.harness/project.json" ]; then
  if ! "$harness_repo_dir/scripts/detect" --write "$target_project_dir" \
      > /dev/null 2> "$tmp_dir/detect.log"; then
    cat "$tmp_dir/detect.log" >&2
    exit 1
  fi
  changed ".harness/project.json (detect 초안)"
  todo ".harness/project.json의 값이 맞는지 확인한다 (묶음, 스킴, 시뮬레이터, 명령)"
fi

# 옛 형식(schemaVersion 1)은 iOS 설정이 최상위에 있다. 묶음 구조(ADR 0019)에 맞게 ios 아래로 옮긴다.
# e2e(행동 기록, 가짜 응답 포트)와 모르는 키는 그대로 위에 둔다.
config_json="$target_project_dir/.harness/project.json"
if [ "$(jq -r '.schemaVersion // 1' "$config_json")" = 1 ]; then
  jq '
    ["generator", "commands", "workspace", "project", "app", "destination", "modules"] as $ios
    | { schemaVersion: 2, platforms: ["ios"], ios: with_entries(select(.key | IN($ios[]))) }
      + with_entries(select(.key | IN($ios[] , "schemaVersion") | not))' \
    "$config_json" > "$tmp_dir/config"
  write_if_changed "$config_json" "$tmp_dir/config" ".harness/project.json (새 형식으로 옮김: iOS 설정을 ios 아래로)"
fi

# 고른 묶음. 하네스 저장소의 packs/<이름>/pack.json이 그 묶음의 파일을 정한다.
packs_dir="$harness_repo_dir/packs"
packs=()
while IFS= read -r pack; do
  [ -n "$pack" ] || continue
  if [ -f "$packs_dir/$pack/pack.json" ]; then
    packs+=("$pack")
  else
    todo ".harness/project.json의 platforms에 있는 '$pack' 묶음이 하네스에 없다. 있는 묶음: $(cd "$packs_dir" && ls | tr '\n' ' ')"
  fi
done < <(jq -r '.platforms // [] | .[]' "$config_json")

# --- 2. 통째로 관리하는 파일 -------------------------------------------------------

# 어느 묶음의 파일인지(pack.json의 files, /로 끝나면 폴더). 고르지 않은 묶음의 파일은 설치하지 않는다.
(
  cd "$template_dir"
  find scripts/harness .harness .claude/rules/harness -type f ! -name '.DS_Store'
) | LC_ALL=C sort > "$tmp_dir/all"
jq -s . "$packs_dir"/*/pack.json > "$tmp_dir/packs.json"
jq -n -r --rawfile all "$tmp_dir/all" --slurpfile packs "$tmp_dir/packs.json" \
  --argjson chosen "$(jq -n '$ARGS.positional' --args ${packs[@]+"${packs[@]}"})" '
  def owner($f): [ $packs[0][] | select(any(.files[]; . as $e | if ($e | endswith("/")) then ($f | startswith($e)) else $e == $f end)) | .name ][0];
  $all | split("\n")[] | select(. != "")
  | select(owner(.) as $o | $o == null or ($chosen | index($o)))' > "$tmp_dir/managed"

while IFS= read -r rel_path; do
  install_file "$rel_path"
done < "$tmp_dir/managed"

# 템플릿에서 사라진 하네스 규칙과 스크립트는 프로젝트에서도 지운다(이름이 바뀐 스크립트가 남지 않게).
# 지난번에 하네스가 설치한 파일(.harness/harness.json의 files)만 지운다. 팀이 scripts/harness/에 넣은 파일은 남긴다.
# 목록이 없으면(목록을 적기 전 버전에서 처음 갱신) 지우지 않는다.
jq -r '.files // [] | .[]' "$target_project_dir/.harness/harness.json" 2>/dev/null | LC_ALL=C sort > "$tmp_dir/installed-before" || : > "$tmp_dir/installed-before"
while IFS= read -r rel_path; do
  case "$rel_path" in
    scripts/harness/* | .claude/rules/harness/* | .harness/*) ;;
    *) continue ;;  # 목록이 잘못돼도 하네스 폴더 밖은 지우지 않는다
  esac
  case "$rel_path" in */../* | ../*) continue ;; esac
  if ! grep -qxF "$rel_path" "$tmp_dir/managed" && [ -f "$target_project_dir/$rel_path" ]; then
    rm "$target_project_dir/$rel_path"
    changed "$rel_path (삭제: template에 없음)"
  fi
done < "$tmp_dir/installed-before"

# 묶음 폴더(.claude/rules/harness/<묶음>/)로 옮긴 규칙의 옛 자리를 지운다(ADR 0019). 같은 규칙이 두 번 읽히지 않게.
# 설치 기록에 파일 목록이 없는 옛 버전에서 갱신할 때도 지운다. rules/harness/는 하네스만 쓰는 폴더다.
while IFS= read -r rel_path; do
  case "$rel_path" in
    .claude/rules/harness/*/*.md) ;;
    *) continue ;;
  esac
  old_path=".claude/rules/harness/$(basename "$rel_path")"
  if ! grep -qxF "$old_path" "$tmp_dir/managed" && [ -f "$target_project_dir/$old_path" ]; then
    rm "$target_project_dir/$old_path"
    changed "$old_path (삭제: $(dirname "$rel_path")/로 옮김)"
  fi
done < "$tmp_dir/managed"

if [ ! -d "$target_project_dir/.claude/rules/project" ]; then
  install_file ".claude/rules/project/.gitkeep"
fi

# --- 3. AGENTS.md ------------------------------------------------------------

# template/AGENTS.md에서 관리 블록(harness:begin ~ harness:end)만 뽑아 둔다.
awk '
  /<!-- harness:begin/   { in_block = 1 }
  in_block               { print }
  /<!-- harness:end -->/ { in_block = 0 }' \
  "$template_dir/AGENTS.md" > "$tmp_dir/block.raw"

# 블록의 "<!-- harness:pack <조각> -->" 줄을 고른 묶음의 packs/<묶음>/agents-<조각>.md로 바꾼다. 없으면 줄만 지운다.
: > "$tmp_dir/block"
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    '<!-- harness:pack '*' -->')
      part="${line#<!-- harness:pack }"
      part="${part% -->}"
      for pack in ${packs[@]+"${packs[@]}"}; do
        [ ! -f "$packs_dir/$pack/agents-$part.md" ] || cat "$packs_dir/$pack/agents-$part.md" >> "$tmp_dir/block"
      done
      ;;
    *) printf '%s\n' "$line" >> "$tmp_dir/block" ;;
  esac
done < "$tmp_dir/block.raw"

agents_md="$target_project_dir/AGENTS.md"

if [ ! -f "$agents_md" ]; then
  # template의 프로젝트 영역에 조립한 관리 블록을 붙인다. 첫 줄 제목 "# 프로젝트 이름"은 폴더 이름으로 바꾼다.
  # 앱 스킴은 묶음마다 있거나 없어(라이브러리, 웹) 어느 프로젝트에나 있는 폴더 이름을 쓴다.
  title="$(basename "$target_project_dir")"
  {
    awk '/<!-- harness:begin/ { exit } { print }' "$template_dir/AGENTS.md" \
      | awk -v title="$title" 'NR == 1 && $0 == "# 프로젝트 이름" { print "# " title; next } { print }'
    cat "$tmp_dir/block"
  } > "$tmp_dir/agents"
  write_if_changed "$agents_md" "$tmp_dir/agents" "AGENTS.md (새로 만듦)"
  todo "AGENTS.md 위쪽 프로젝트 영역(소개, 구조, 프로젝트 규칙)을 채운다"

elif grep -q '<!-- harness:begin' "$agents_md"; then
  # 관리 블록만 template의 블록으로 바꾼다.
  awk -v block="$tmp_dir/block" '
    /<!-- harness:begin/ {
      while ((getline line < block) > 0) print line
      skip = 1
      next
    }
    skip && /<!-- harness:end -->/ {
      skip = 0
      next
    }
    !skip { print }' \
    "$agents_md" > "$tmp_dir/agents"
  write_if_changed "$agents_md" "$tmp_dir/agents" "AGENTS.md (관리 블록 갱신)"

else
  # 관리 블록이 없으면 기존 내용 끝에 붙인다.
  {
    cat "$agents_md"
    echo
    cat "$tmp_dir/block"
  } > "$tmp_dir/agents"
  write_if_changed "$agents_md" "$tmp_dir/agents" "AGENTS.md (끝에 관리 블록 추가)"
  todo "AGENTS.md의 기존 내용을 프로젝트 영역(소개, 구조, 프로젝트 규칙)으로 정리하고," \
    "관리 블록과 겹치거나 충돌하는 내용을 지운다"
fi

# --- 4. CLAUDE.md ------------------------------------------------------------

if [ ! -f "$target_project_dir/CLAUDE.md" ]; then
  install_file "CLAUDE.md"
elif ! grep -qx '@AGENTS.md' "$target_project_dir/CLAUDE.md"; then
  todo "CLAUDE.md에 @AGENTS.md import가 없다." \
    "그 전까지 Claude Code는 AGENTS.md를 읽지 않는다." \
    "내용을 AGENTS.md 프로젝트 영역으로 옮기고 template/CLAUDE.md 형태로 바꾼다"
fi

in_git() {
  git -C "$target_project_dir" rev-parse --git-dir > /dev/null 2>&1
}

# --- 5. 공유 설정: .claude/settings.json -------------------------------------------
# 권한 규칙을 합치고, GitHub 마켓플레이스와 플러그인을 등록한다.
# 이 파일을 커밋하면 팀원이 저장소를 열 때 Claude Code가 마켓플레이스 추가와 플러그인 설치를 권한다.

settings_json="$target_project_dir/.claude/settings.json"
settings_input="$settings_json"
[ -f "$settings_input" ] || settings_input="$template_dir/.claude/settings.json"

# 넣을 규칙: template(공통) 규칙에 고른 묶음의 packs/<묶음>/settings.json 규칙을 더한다.
pack_settings=()
for pack in ${packs[@]+"${packs[@]}"}; do
  [ ! -f "$packs_dir/$pack/settings.json" ] || pack_settings+=("$packs_dir/$pack/settings.json")
done
jq -s '{ permissions: {
    deny: [ .[].permissions.deny // [] | .[] ],
    ask: [ .[].permissions.ask // [] | .[] ] } }' \
  "$template_dir/.claude/settings.json" ${pack_settings[@]+"${pack_settings[@]}"} > "$tmp_dir/wanted-settings"

# 지난번에 하네스가 넣은 규칙(.harness/harness.json의 permissions). 이번에 넣을 규칙에 없으면 지운다.
# 기록이 없으면(기록을 적기 전 버전) 지우지 않는다. 팀이 직접 넣은 규칙은 기록에 없으니 남는다.
jq '{ permissions: { deny: (.permissions.deny // []), ask: (.permissions.ask // []) } }' \
  "$target_project_dir/.harness/harness.json" > "$tmp_dir/added-before" 2> /dev/null \
  || echo '{ "permissions": { "deny": [], "ask": [] } }' > "$tmp_dir/added-before"

# 프로젝트의 deny/ask 목록에 없는 규칙만 뒤에 붙인다. 나머지 설정은 그대로 둔다.
jq -s --arg market "$marketplace_name" --arg repo "$marketplace_repo" --arg plugin "$plugin_id" '
  def merge($current; $wanted; $before):
    [ ($current // [])[] | . as $rule
      | select((($before // []) | index($rule)) == null or (($wanted // []) | index($rule)) != null) ]
    | . as $kept
    | $kept + [ ($wanted // [])[] | . as $rule | select(($kept | index($rule)) | not) ];

  .[0] as $project
  | .[1] as $template
  | .[2] as $before
  | $project
  | .permissions.deny = merge($project.permissions.deny; $template.permissions.deny; $before.permissions.deny)
  | .permissions.ask = merge($project.permissions.ask; $template.permissions.ask; $before.permissions.ask)
  | .extraKnownMarketplaces[$market] = { source: { source: "github", repo: $repo } }
  | .enabledPlugins[$plugin] = true' \
  "$settings_input" "$tmp_dir/wanted-settings" "$tmp_dir/added-before" > "$tmp_dir/settings"
write_if_changed "$settings_json" "$tmp_dir/settings" ".claude/settings.json (권한 규칙, 플러그인 등록)"

if in_git && git -C "$target_project_dir" check-ignore -q .claude/settings.json; then
  todo ".claude/settings.json이 git에서 무시된다. 권한 규칙과 플러그인 등록이 팀원에게 가지 않는다." \
    "개인 값은 .claude/settings.local.json으로 옮기고 settings.json을 커밋한다"
fi

# --- 6. 개발용 플러그인: .claude/settings.local.json ------------------------------------
# --dev면 같은 이름의 마켓플레이스를 이 저장소 디렉터리로 덮어쓴다. 로컬 설정이 프로젝트 설정보다 우선한다.
# 디렉터리 마켓플레이스는 플러그인을 복사하지 않고 그 자리에서 읽어서, 고친 내용이 다음 세션부터 반영된다.

local_settings_json="$target_project_dir/.claude/settings.local.json"

if [ "$dev" = 1 ]; then
  local_settings_input="$local_settings_json"   # 아직 없으면 빈 JSON에서 시작한다
  if [ ! -f "$local_settings_input" ]; then
    echo '{}' > "$tmp_dir/empty.json"
    local_settings_input="$tmp_dir/empty.json"
  fi
  jq --arg market "$marketplace_name" --arg path "$harness_repo_dir" --arg plugin "$plugin_id" '
    .extraKnownMarketplaces[$market] = { source: { source: "directory", path: $path } }
    | .enabledPlugins[$plugin] = true' \
    "$local_settings_input" > "$tmp_dir/local"
  write_if_changed "$local_settings_json" "$tmp_dir/local" ".claude/settings.local.json (개발용 플러그인)"

  if in_git && ! git -C "$target_project_dir" check-ignore -q .claude/settings.local.json; then
    todo ".claude/settings.local.json이 git에서 무시되지 않는다." \
      "이 저장소의 절대 경로가 들어 있으니 .gitignore에 추가한다"
  fi
elif [ -f "$local_settings_json" ] \
  && jq -e --arg market "$marketplace_name" '.extraKnownMarketplaces[$market].source.source == "directory"' \
    "$local_settings_json" > /dev/null; then
  # 예전 dev-install이나 --dev가 남긴 디렉터리 마켓플레이스를 지워 GitHub 버전을 쓰게 한다.
  jq --arg market "$marketplace_name" '
    del(.extraKnownMarketplaces[$market])
    | if .extraKnownMarketplaces == {} then del(.extraKnownMarketplaces) else . end' \
    "$local_settings_json" > "$tmp_dir/local"
  write_if_changed "$local_settings_json" "$tmp_dir/local" ".claude/settings.local.json (개발용 플러그인 지움)"
fi

# --- 7. 설치 기록: .harness/harness.json ----------------------------------------------
# 프로젝트 파일이 어느 하네스 버전인지 남긴다. doctor가 설치된 플러그인 버전과 비교한다.

# files: 이번에 설치한 하네스 파일. 다음 갱신 때 template에서 사라진 것만 지우는 데 쓴다.
# packs: 이번에 설치한 묶음. 고르는 곳은 project.json의 platforms이고, 이 값은 기록이다.
# permissions: 이번에 넣은 권한 규칙. 다음 갱신 때 template·묶음에서 빠진 규칙만 지우는 데 쓴다.
jq -n --arg version "$harness_version" --rawfile files "$tmp_dir/managed" \
  --argjson packs "$(jq -n '$ARGS.positional' --args ${packs[@]+"${packs[@]}"})" \
  --slurpfile wanted "$tmp_dir/wanted-settings" \
  '{ version: $version, packs: $packs, files: ($files | split("\n") | map(select(. != ""))),
     permissions: $wanted[0].permissions }' > "$tmp_dir/harness"
write_if_changed "$target_project_dir/.harness/harness.json" "$tmp_dir/harness" ".harness/harness.json ($harness_version)"

# --- 검사 목록: .harness/checks.json ------------------------------------------------
# 검사는 팀이 고른다. 하네스가 파일을 쓰지 않고, Claude 세션에서 setup 안내대로 사용자에게 묻고 쓰게 한다(ai-bouncer setup, ADR 0020).
if [ ! -f "$target_project_dir/.harness/checks.json" ]; then
  todo "검사 목록(.harness/checks.json)이 없다. Claude 세션에서 \"scripts/harness/setup 안내대로 검사를 정해 줘\"라고 한다"
fi

# --- 결과 ---------------------------------------------------------------------

if [ -z "$changes" ]; then
  echo "✓ $mode · 바뀐 것 없음 · $target_project_dir"
else
  echo "✓ $mode · $target_project_dir"
  echo "  바꾼 파일:"
  printf '%s' "$changes"
fi

if [ -n "$todos" ]; then
  echo "  직접 할 일:"
  printf '%s' "$todos"
fi
