#!/usr/bin/env bash
# 하네스를 프로젝트에 처음 설치한다. 하는 일은 scripts/sync와 같고, 이미 설치된 프로젝트는 거절한다.
# 설정 파일(.harness/project.json)이 없으면 scripts/detect로 초안을 만든다.
set -euo pipefail

case "${1:-}" in
  -h | --help)
    cat <<'USAGE'
사용법: scripts/init [--dev] <프로젝트 경로>

  하네스를 처음 설치한다. 설치 뒤 출력되는 "직접 할 일"을 마치고 커밋한다.
  갱신은 scripts/sync, 점검은 프로젝트 안에서 scripts/harness/doctor로 한다.
  --dev는 scripts/sync --help 참고
USAGE
    exit 0
    ;;
esac

exec "$(dirname "$0")/sync" --init "$@"
