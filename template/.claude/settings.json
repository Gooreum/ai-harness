{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(* .env)",
      "Bash(* .env.*)",
      "Bash(* */.env)",
      "Bash(* */.env.*)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/keystore.properties)",
      "Read(**/.npmrc)",
      "Read(**/credentials.json)"
    ],
    "ask": []
  }
}
