#!/usr/bin/env bash
# 이 프로젝트에서 하네스가 제대로 돌 수 있는지 점검한다. 아무것도 고치지 않는다.
# 도구, 설정 파일, 설치된 파일, 플러그인 버전을 본다. 고치는 방법을 한 줄씩 함께 보여 준다.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

case "${1:-}" in
  -h | --help)
    cat <<'EOF'
사용법: scripts/harness/doctor

  하네스가 이 프로젝트에서 돌 수 있는지 점검한다. 파일은 고치지 않는다.
  ✕ 문제: 하네스의 일부가 동작하지 않는다
  ! 주의: 동작은 하지만 팀원에게 공유되지 않거나 오래됐다

  종료 코드: 문제가 없으면 0(주의만 있어도 0), 문제가 있으면 1
EOF
    exit 0
    ;;
esac

# jq가 없으면 스크립트뿐 아니라 하네스 훅(단계 지시, Stop 게이트, 생성 파일 보호)도 아무 말 없이 꺼진다.
if ! command -v jq > /dev/null 2>&1; then
  echo "✕ doctor · 문제 1"
  echo "  ✕ jq가 없다. 스크립트가 돌지 않고, 플러그인 훅이 모두 아무 말 없이 꺼져 있다"
  echo "      → jq를 설치한다 (macOS 15 이상은 /usr/bin/jq 기본 포함, 그 전은 brew install jq)"
  exit 1
fi
harness_init

problems=0
warnings=0
report=""

problem() {
  problems=$((problems + 1))
  report="$report  ✕ $1"$'\n'
  [ -z "${2:-}" ] || report="$report      → $2"$'\n'
}
warn() {
  warnings=$((warnings + 1))
  report="$report  ! $1"$'\n'
  [ -z "${2:-}" ] || report="$report      → $2"$'\n'
}
in_git() { git -C "$root" rev-parse --git-dir > /dev/null 2>&1; }
ignored() { in_git && git -C "$root" check-ignore -q "$1"; }

# --- 도구·설정 -------------------------------------------------------------------

if [ -n "$(cfg .e2e.network.port)" ] && ! command -v python3 > /dev/null 2>&1; then
  warn "python3가 없어 가짜 응답 서버(harness-network MCP)가 뜨지 않는다" "xcode-select --install"
fi
for f in checks.json conventions.json; do
  [ ! -f "$root/.harness/$f" ] || jq empty "$root/.harness/$f" 2> /dev/null || problem ".harness/${f}가 올바른 JSON이 아니다"
done

# 검사 목록의 run이 실제로 돌 수 있는지 본다. 안 되면 verify 단계를 영영 넘지 못하거나, 결과가 없어 늘 막힌다.
# - run의 첫 낱말(명령)이 프로젝트 안의 실행 파일이거나 PATH에 있어야 한다.
# - run이 "scripts/harness/passed <이름>"이면 그 결과를 만드는 것이 있어야 한다:
#   prompt의 "record <이름>", prompt가 부르는 이름이 <이름>인 실행 파일(결과를 직접 남기는 저장소 도구),
#   또는 리뷰 서브에이전트(review 결과는 훅이 쓴다).
checks_file="$root/.harness/checks.json"
auto_runs=""   # Stop 훅이 그대로 실행하는 run 중 scripts/harness/passed가 아닌 것. 결과 끝에 참고로 보여 준다
if [ -f "$checks_file" ] && jq empty "$checks_file" 2> /dev/null; then
  while IFS=$'\t' read -r name run prompt; do
    [ -n "$run" ] || continue
    cmd="${run%% *}"
    case "$run" in
      scripts/harness/passed\ *) ;;
      *) auto_runs="${auto_runs:+$auto_runs; }$name: $run" ;;
    esac
    if [ "${cmd#*/}" != "$cmd" ]; then
      [ -x "$root/$cmd" ] || problem "checks.json의 '$name' run 명령이 없다: $cmd" "run을 고치거나 하네스 저장소에서 scripts/sync <이 프로젝트>"
    elif ! command -v "$cmd" > /dev/null 2>&1; then
      problem "checks.json의 '$name' run 명령을 찾지 못했다: $cmd" "설치하거나 run을 고친다"
    fi
    case "$run" in
      scripts/harness/passed\ *) ;;
      *) continue ;;
    esac
    result="$(printf '%s' "${run#scripts/harness/passed }" | awk '{ print $1 }')"
    [ "$result" != review ] || continue
    case "$prompt" in
      *"record $result "* | *"record $result") continue ;;
    esac
    made=""
    for w in $(printf '%s' "$prompt" | tr -c 'A-Za-z0-9_./-' ' '); do
      case "$w" in
        */"$result") [ ! -x "$root/$w" ] || { made=1; break; } ;;
      esac
    done
    [ -n "$made" ] || problem "checks.json의 '$name'이 결과 '$result'를 확인하지만 만드는 곳이 없다" \
      "prompt에 scripts/harness/record $result <명령>을 적는다"
  done < <(jq -r '.checks // [] | .[] | [.name // "?", .run // "", .prompt // ""] | map(gsub("[\t\n]"; " ")) | @tsv' "$checks_file")
fi

# --- 설치된 파일 -----------------------------------------------------------------

installed_version=""
if [ -f "$root/.harness/harness.json" ]; then
  installed_version="$(jq -r '.version // empty' "$root/.harness/harness.json")"
else
  warn "설치 기록(.harness/harness.json)이 없어 버전을 비교할 수 없다" "하네스 저장소에서 scripts/sync <이 프로젝트>"
fi
grep -q '<!-- harness:begin' "$root/AGENTS.md" 2> /dev/null \
  || problem "AGENTS.md에 하네스 관리 블록이 없다" "하네스 저장소에서 scripts/sync <이 프로젝트>"
grep -qx '@AGENTS.md' "$root/CLAUDE.md" 2> /dev/null \
  || problem "CLAUDE.md가 AGENTS.md를 불러오지 않는다 (@AGENTS.md 줄이 없다)" "Claude Code가 하네스 지침을 읽지 않는다. CLAUDE.md에 @AGENTS.md를 넣는다"
if [ ! -d "$root/.claude/rules/harness" ]; then
  problem ".claude/rules/harness/가 없다" "하네스 저장소에서 scripts/sync <이 프로젝트>"
elif ignored .claude/rules/harness/wiki.md; then
  warn ".claude/rules/가 git에서 무시돼 하네스 규칙이 커밋되지 않는다" ".gitignore를 .claude/* 와 !.claude/rules/ 형태로 바꾼다"
fi
if ignored .claude/settings.json; then
  warn ".claude/settings.json이 git에서 무시돼 권한 규칙과 플러그인 등록이 팀원에게 가지 않는다" \
    "개인 값은 .claude/settings.local.json으로 옮기고 settings.json을 커밋한다"
fi

# --- 플러그인 ------------------------------------------------------------------
# 프로젝트 파일(스크립트·규칙)과 플러그인(훅·스킬)은 같은 버전이어야 한다. 훅이 설정 파일 형식을 읽기 때문이다.

plugin_id="harness@ai-harness"
enabled=""
for f in "$root/.claude/settings.local.json" "$root/.claude/settings.json"; do
  [ -f "$f" ] || continue
  v="$(jq -r --arg id "$plugin_id" '.enabledPlugins[$id] // empty' "$f" 2> /dev/null || true)"
  if [ -n "$v" ]; then
    enabled="$v"
    break
  fi
done
if [ "$enabled" != "true" ]; then
  problem "플러그인 ${plugin_id}가 켜져 있지 않다 (.claude/settings.json)" "하네스 저장소에서 scripts/sync <이 프로젝트>"
elif command -v claude > /dev/null 2>&1; then
  # 이 프로젝트에 설치된 것(projectPath)이나 사용자 전체에 설치된 것을 찾는다.
  plugin="$(claude plugin list --json 2> /dev/null | jq -c --arg id "$plugin_id" --arg root "$root" '
    [ .[]? | select(.id == $id and (.projectPath == $root or .scope == "user")) ]
    | (map(select(.projectPath == $root)) + .) | first // empty' 2> /dev/null || true)"
  if [ -z "$plugin" ]; then
    problem "플러그인 ${plugin_id}가 이 프로젝트에 설치되지 않았다" \
      "이 프로젝트에서 claude를 열고 마켓플레이스·플러그인 설치 안내를 받아들이거나, claude plugin install $plugin_id --scope project"
  else
    # 디렉터리 마켓플레이스(--dev)는 폴더를 그 자리에서 읽으므로 폴더의 버전을 본다.
    plugin_version="$(printf '%s' "$plugin" | jq -r '.folderVersion // .version // empty')"
    if [ "$(printf '%s' "$plugin" | jq -r '.enabled')" = "false" ]; then
      problem "플러그인 ${plugin_id}가 설치됐지만 꺼져 있다" "claude plugin enable $plugin_id"
    elif [ -n "$installed_version" ] && [ "$plugin_version" != "$installed_version" ]; then
      newer="$(printf '%s\n%s\n' "$plugin_version" "$installed_version" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)"
      if [ "$newer" = "$installed_version" ]; then
        problem "플러그인($plugin_version)이 프로젝트 파일($installed_version)보다 오래됐다" \
          "claude plugin marketplace update ai-harness && claude plugin update $plugin_id"
      else
        problem "프로젝트 파일($installed_version)이 플러그인($plugin_version)보다 오래됐다" \
          "하네스 저장소에서 scripts/sync <이 프로젝트>"
      fi
    fi
  fi
else
  warn "claude CLI가 없어 설치된 플러그인 버전을 확인하지 못했다"
fi

# 예전 이름(ios-harness@ios-ai-harness)의 플러그인이 아직 켜져 있으면 훅이 두 번 돈다.
old_plugin_id="ios-harness@ios-ai-harness"
old_on=""
for f in "$root/.claude/settings.local.json" "$root/.claude/settings.json"; do
  [ -f "$f" ] && [ "$(jq -r --arg id "$old_plugin_id" '.enabledPlugins[$id] // empty' "$f" 2> /dev/null)" = "true" ] && old_on=1
done
if [ -z "$old_on" ] && command -v claude > /dev/null 2>&1 \
  && claude plugin list --json 2> /dev/null | jq -e --arg id "$old_plugin_id" --arg root "$root" '
    any(.[]?; .id == $id and .enabled == true and (.projectPath == $root or .scope == "user"))' > /dev/null 2>&1; then
  old_on=1
fi
if [ -n "$old_on" ]; then
  problem "예전 이름의 플러그인 ${old_plugin_id}가 켜져 있어 훅이 두 번 돈다" \
    "하네스 저장소에서 scripts/sync <이 프로젝트>, 그다음 claude plugin uninstall $old_plugin_id"
fi

# --- 결과 ---------------------------------------------------------------------

label="하네스 ${installed_version:-?}"
# checks.json의 run은 단계를 넘길 때 Stop 훅이 묻지 않고 실행한다. 내려받은 저장소라면 무엇이 도는지 알아야 한다.
auto_note=""
[ -z "$auto_runs" ] || auto_note="  참고: 단계를 넘길 때 훅이 checks.json의 run을 묻지 않고 실행한다 — $auto_runs"
if [ "$problems" -eq 0 ] && [ "$warnings" -eq 0 ]; then
  echo "✓ doctor · 문제 없음 · $label"
  [ -z "$auto_note" ] || echo "$auto_note"
  exit 0
fi
if [ "$problems" -eq 0 ]; then
  echo "✓ doctor · 주의 $warnings · $label"
else
  echo "✕ doctor · 문제 $problems · 주의 $warnings · $label"
fi
printf '%s' "$report"
[ -z "$auto_note" ] || echo "$auto_note"
[ "$problems" -eq 0 ]
