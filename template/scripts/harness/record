#!/usr/bin/env bash
# 아무 명령이나 실행하고 결과를 .harness/out/<이름>.json에 남긴다. passed가 이 결과로 게이트를 판정한다.
#
# ai-bouncer의 `bouncer record`를 따른다. 다른 점(ADR 0018):
#   - 결과는 로그 끝의 `exit: N` 줄이 아니라 JSON(passed, summary, exit, command)으로 남긴다.
#     build·test·e2e 같은 다른 스크립트의 결과와 형식을 맞춰, passed가 한 가지로 읽게 한다.
#   - 화면에는 전체 출력이 아니라 성공하면 한 줄, 실패하면 로그 끝부분만 보여 준다. 전체 로그는 .harness/out/<이름>.log에 둔다.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

usage() {
  cat <<'HELP'
사용법: scripts/harness/record <검사 이름> <명령>...

  명령을 실행하고 결과를 .harness/out/<검사 이름>.json에, 전체 출력을 .harness/out/<검사 이름>.log에 남긴다.
  명령을 따옴표로 묶어 하나로 주면 bash -c로 실행한다(파이프·&& 사용 가능).
  감시 모드(watch)로 떠서 끝나지 않는 일을 막으려고 CI=1을 넣어 실행한다.
  예: scripts/harness/record typecheck npm run typecheck
      scripts/harness/record lint "npm run lint -- --max-warnings 0"
  checks.json의 run에는 "scripts/harness/passed <검사 이름>"을 쓴다.

  종료 코드: 명령의 종료 코드. 인자 오류 2
HELP
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
esac
[ $# -ge 2 ] || { usage >&2; exit 2; }
name="$1"; shift
# 검사 이름은 결과 파일 이름이 된다. ai-bouncer result_name과 같은 규칙.
[[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || harness_die "검사 이름은 영문·숫자·-·_만 쓸 수 있습니다: $name"

harness_init
result="$out_dir/$name.json"
log="$out_dir/$name.log"
rel=".harness/out/$name"
tail_lines="${HARNESS_RECORD_TAIL:-30}"

if [ $# -eq 1 ]; then command_text="$1"; else command_text="$*"; fi
# 앞 결과가 남아 있으면 실행 중에 passed가 옛 결과로 통과할 수 있다. 먼저 지운다.
rm -f "$result"

start=$(date +%s)
set +e
if [ $# -eq 1 ]; then
  (cd "$root" && CI=1 bash -c "$1") > "$log" 2>&1 < /dev/null
else
  (cd "$root" && CI=1 "$@") > "$log" 2>&1 < /dev/null
fi
rc=$?
set -e
secs=$(( $(date +%s) - start ))

if [ "$rc" -eq 0 ]; then
  summary="통과 · ${secs}s"
else
  summary="실패 (종료 코드 ${rc}) · ${secs}s"
fi
jq -n --argjson passed "$([ "$rc" -eq 0 ] && echo true || echo false)" --arg summary "$summary" \
  --argjson exit "$rc" --arg command "$command_text" --argjson seconds "$secs" \
  '{passed: $passed, summary: $summary, exit: $exit, command: $command, seconds: $seconds}' > "$result"

if [ "$rc" -eq 0 ]; then
  echo "✓ ${name} · ${summary}"
  exit 0
fi
echo "✗ ${name} · ${summary}"
lines=$(wc -l < "$log" | tr -d ' ')
if [ "$lines" -gt "$tail_lines" ]; then
  echo "  (출력 ${lines}줄 중 끝 ${tail_lines}줄. 전체는 ${rel}.log)"
fi
tail -n "$tail_lines" "$log" | sed 's/^/  /'
echo "  로그: ${rel}.log"
exit "$rc"
