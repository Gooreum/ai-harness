#!/usr/bin/env bash
# 팀 컨벤션(.harness/conventions.json)을 검사하고 점수로 판정한다. 검사에는 AI를 쓰지 않는다.
# 규칙 종류마다 맡는 도구가 다르다: pattern은 SwiftLint, format은 swift-format, dependency는 tuist graph·inspect.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

usage() {
  cat <<'EOF'
사용법: scripts/harness/lint [--base 브랜치] [--all]

  .harness/conventions.json의 규칙으로 Swift 파일을 검사한다.
  금지 패턴(pattern)은 SwiftLint, 형식(format)은 swift-format(Xcode 포함)이 본다.
  모듈 의존(dependency)은 Tuist 프로젝트에서 본다. 선언한 의존은 manifest가 바뀌었거나 --all일 때
  tuist graph로, import만 한 의존은 거기에 더해 import 줄이 바뀌었을 때 tuist inspect implicit-imports로 본다.
  100점에서 위반마다 감점하고, 기준 점수(passScore) 이상이면 통과다.
  결과는 .harness/out/lint.json에 남는다.

  기본           커밋하지 않은 변경(HEAD 대비 수정 + 새 파일)을 본다 (unit-test와 같은 기준)
  --base 브랜치   그 브랜치에서 갈라진 뒤의 모든 변경을 본다
  --all          git이 추적하는 모든 Swift 파일을 본다

  종료 코드: 0 통과, 1 기준 미달, 2 설정·도구 문제
EOF
}

base=""
all=0
while [ $# -gt 0 ]; do
  case "$1" in
    --base) [ $# -ge 2 ] || harness_die "--base에 브랜치가 필요합니다"; base="$2"; shift ;;
    --all) all=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "lint: 알 수 없는 인자: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

harness_init
conventions="$root/.harness/conventions.json"
result="$out_dir/lint.json"
rm -f "$result"

if [ ! -f "$conventions" ]; then
  echo "· lint · .harness/conventions.json이 없어 건너뜁니다"
  exit 0
fi
conventions_check "$conventions"
if conventions_has_kind "$conventions" pattern; then
  command -v swiftlint >/dev/null 2>&1 || harness_die "swiftlint가 필요합니다 (brew install swiftlint)"
fi
if conventions_has_kind "$conventions" format; then
  xcrun --find swift-format >/dev/null 2>&1 || harness_die "swift-format이 필요합니다. Xcode 16 이상에 들어 있습니다 (xcode-select로 Xcode를 고르세요)"
fi
if conventions_has_kind "$conventions" dependency; then
  [ "$(cfg .generator)" = tuist ] || harness_die "dependency 규칙은 Tuist 프로젝트에서만 씁니다 (generator: $(cfg .generator)). 단일 모듈 앱의 레이어는 pattern 규칙의 included와 금지 정규식으로 적으세요"
  command -v tuist >/dev/null 2>&1 || harness_die "tuist가 필요합니다"
fi

# --- 검사할 파일 ---------------------------------------------------------------

if [ "$all" = 1 ] || ! git -C "$root" rev-parse --git-dir >/dev/null 2>&1; then
  files="$(cd "$root" && { git ls-files '*.swift'; git ls-files -o --exclude-standard '*.swift'; } 2>/dev/null | LC_ALL=C sort -u)"
  [ -n "$files" ] || files="$(cd "$root" && find . -name '*.swift' -not -path './.harness/*' -not -path '*/.build/*' -not -path '*/Derived/*' | sed 's|^\./||' | LC_ALL=C sort)"
else
  files="$(harness_changed_files "$base" | { grep '\.swift$' || true; })"
fi
# 지운 파일은 뺀다.
existing=""
while IFS= read -r f; do
  [ -n "$f" ] && [ -f "$root/$f" ] && existing="$existing$f"$'\n'
done <<< "$files"
files="$(printf '%s' "$existing")"
count="$(printf '%s' "$files" | grep -c . || true)"

# --- 실행 ---------------------------------------------------------------------

parts=()
if [ "$count" -gt 0 ]; then
  args=()
  while IFS= read -r f; do args+=("$f"); done <<< "$files"

  if conventions_has_kind "$conventions" pattern; then
    sl_config="$out_dir/swiftlint.yml"
    conventions_to_swiftlint "$conventions" > "$sl_config"
    raw="$out_dir/lint-swiftlint.json"
    # swiftlint는 위반이 있으면 0이 아닌 코드로 끝난다. 판정은 아래에서 JSON으로 한다.
    (cd "$root" && swiftlint lint --config "$sl_config" --reporter json --quiet --no-cache "${args[@]}" > "$raw" 2> "$out_dir/lint-swiftlint.err") || true
    if ! jq -e 'type == "array"' "$raw" >/dev/null 2>&1; then
      echo "✗ lint · swiftlint 실행 실패" >&2
      head -n 20 "$out_dir/lint-swiftlint.err" >&2
      exit 2
    fi
    lint_violations "$conventions" "$raw" "$root" > "$out_dir/lint-pattern.json"
    parts+=("$out_dir/lint-pattern.json")
  fi

  if conventions_has_kind "$conventions" format; then
    xcrun swift-format dump-configuration > "$out_dir/swift-format-base.json"
    if ! conventions_to_swiftformat "$conventions" "$out_dir/swift-format-base.json" > "$out_dir/swift-format.json" 2> "$out_dir/lint-format.err"; then
      harness_die ".harness/conventions.json: swift-format에 없는 규칙입니다: $(cat "$out_dir/lint-format.err"). 'xcrun swift-format dump-configuration'의 rules나 $(printf '%s' "$swiftformat_layout_rules" | jq -r 'join("·")') 중에서 고르세요"
    fi
    raw="$out_dir/lint-swift-format.txt"
    (cd "$root" && xcrun swift-format lint --configuration "$out_dir/swift-format.json" "${args[@]}" > "$raw" 2>&1) || true
    if grep -q '^error: ' "$raw"; then
      echo "✗ lint · swift-format 실행 실패" >&2
      grep '^error: ' "$raw" | head -n 20 >&2
      exit 2
    fi
    swiftformat_violations "$conventions" "$raw" "$root" > "$out_dir/lint-format.json"
    parts+=("$out_dir/lint-format.json")
  fi
fi

# 모듈 의존은 두 군데서 본다.
# - 선언한 의존(tuist graph): manifest가 바뀌었거나 --all일 때
# - import만 하고 선언하지 않은 의존(tuist inspect implicit-imports): 위의 경우와 Swift 파일의 import 줄이 바뀌었을 때
deps_checked=0
uncovered='[]'
if conventions_has_kind "$conventions" dependency; then
  manifest_changed=0; imports_changed=0
  { [ "$all" = 1 ] || lint_touches_manifest "$files"; } && manifest_changed=1
  { [ "$manifest_changed" = 1 ] || lint_touches_imports "$base"; } && imports_changed=1
  echo '[]' > "$out_dir/lint-edges-declared.json"
  echo '[]' > "$out_dir/lint-edges-implicit.json"
  if [ "$manifest_changed" = 1 ]; then
    graph_dir="$out_dir/graph"
    rm -rf "$graph_dir" && mkdir -p "$graph_dir"   # tuist graph는 없는 폴더에는 쓰지 않는다
    if ! (cd "$root" && tuist graph -f dot --no-open -o "$graph_dir" > "$out_dir/lint-graph.log" 2>&1) || [ ! -f "$graph_dir/graph.dot" ]; then
      echo "✗ lint · tuist graph 실행 실패 (tuist install을 먼저 했는지 확인)" >&2
      tail -n 20 "$out_dir/lint-graph.log" >&2
      exit 2
    fi
    dot_edges "$graph_dir/graph.dot" > "$out_dir/lint-edges-declared.json"
    uncovered="$(uncovered_modules "$conventions" "$graph_dir/graph.dot" "$root")"
  fi
  if [ "$imports_changed" = 1 ]; then
    raw="$out_dir/lint-implicit-imports.txt"
    # 숨은 의존이 있으면 0이 아닌 코드로 끝난다. 그때는 출력에서 의존을 읽는다.
    if ! (cd "$root" && tuist inspect implicit-imports > "$raw" 2>&1) && ! grep -q 'implicitly depends on' "$raw"; then
      echo "✗ lint · tuist inspect implicit-imports 실행 실패 (tuist install을 먼저 했는지 확인)" >&2
      tail -n 20 "$raw" >&2
      exit 2
    fi
    implicit_edges "$raw" > "$out_dir/lint-edges-implicit.json"
  fi
  if [ "$imports_changed" = 1 ]; then
    jq -s 'add' "$out_dir/lint-edges-declared.json" "$out_dir/lint-edges-implicit.json" > "$out_dir/lint-edges.json"
    dependency_violations "$conventions" "$out_dir/lint-edges.json" "$root" > "$out_dir/lint-dependency.json"
    parts+=("$out_dir/lint-dependency.json")
    deps_checked=1
  fi
fi

if [ "${#parts[@]}" -gt 0 ]; then
  violations="$(lint_merge_violations "${parts[@]}")"
else
  violations='[]'
fi

pass_score="$(jq -r '.passScore // 95' "$conventions")"
jq -n --argjson v "$violations" --argjson pass "$pass_score" --argjson files "$count" --argjson unc "$uncovered" '
  ([100 - ($v | map(.penalty) | add // 0), 0] | max) as $score
  | { passed: ($score >= $pass), score: $score, passScore: $pass, files: $files, violations: $v, uncoveredModules: $unc }' > "$result"

score="$(jq -r .score "$result")"
n="$(jq -r '.violations | length' "$result")"
if [ "$count" -eq 0 ] && [ "$deps_checked" = 0 ]; then
  echo "✓ lint · 바뀐 Swift 파일 없음"
  exit 0
fi
[ "$deps_checked" = 1 ] && deps_note=" · 모듈 의존 포함" || deps_note=""
if jq -e .passed "$result" >/dev/null; then
  mark="✓"
else
  mark="✗"
fi
if [ "$n" -eq 0 ]; then
  echo "$mark lint · ${score}점 (기준 $pass_score) · 파일 ${count}개${deps_note}"
else
  echo "$mark lint · ${score}점 (기준 $pass_score) · 파일 ${count}개${deps_note} · 위반 ${n}개"
  jq -r --argjson max "$max_errors" '.violations[:$max][]
    | "  \(.file):\(.line): [\(.rule)] \(.message) (−\(.penalty))"' "$result"
  [ "$n" -le "$max_errors" ] || echo "  … 외 $((n - max_errors))개 (전체: .harness/out/lint.json)"
fi
# 규칙이 없는 모듈은 감점하지 않고 알리기만 한다. 새 모듈을 어떻게 다룰지는 사람이 정한다.
if [ "$(printf '%s' "$uncovered" | jq length)" -gt 0 ]; then
  echo "  · 의존 규칙에 없는 모듈: $(printf '%s' "$uncovered" | jq -r 'join(", ")') (.harness/conventions.json의 from·forbid에 넣을지 정하세요)"
fi
jq -e .passed "$result" >/dev/null
