#!/usr/bin/env bash
# 이 저장소의 하네스 설정을 사용자와 대화로 정하라는 안내를 낸다. 아무것도 쓰지 않는다.
# 정하는 것: 검사 목록(.harness/checks.json), 자동 생성 파일(project.json의 generated), 직접 고치면 안 되는 파일(권한),
# AGENTS.md의 빌드·테스트 명령. 저장소에서 찾은 명령과 단서를 함께 보여 준다. 에이전트가 이 안내대로 묻고, 답을 받아 쓴다.
# 하네스는 플랫폼을 모른다. 어떤 도구를 어떻게 쓰는지는 사용자가 답한다(ADR 0024). ai-bouncer의 `bouncer setup`을 따른다(ADR 0020).
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

case "${1:-}" in
  -h | --help)
    cat <<'EOF'
사용법: scripts/harness/setup

  검사 목록(.harness/checks.json), 생성 파일, 직접 고치면 안 되는 파일, 빌드·테스트 명령을
  사용자와 정하는 안내를 출력한다. 파일은 쓰지 않는다.
  Claude 세션에서 에이전트가 이 안내대로 사용자에게 묻고 설정을 쓴다.
EOF
    exit 0
    ;;
esac

harness_init
checks_json="$root/.harness/checks.json"

# --- 저장소에서 검사 명령 찾기 (ai-bouncer setup.sh와 같은 규칙) ----------------------------
found=()
add() { found+=("$1"$'\t'"$2"$'\t'"$3"); } # 이름, 명령, 근거
cd "$root"
if [ -f package.json ]; then
  pm="npm run"
  [ ! -f pnpm-lock.yaml ] || pm="pnpm"
  [ ! -f yarn.lock ] || pm="yarn"
  { [ ! -f bun.lockb ] && [ ! -f bun.lock ]; } || pm="bun run"
  for k in test lint typecheck type-check build e2e test:e2e; do
    jq -e --arg k "$k" '.scripts[$k]' package.json > /dev/null 2>&1 || continue
    id="${k//:/-}"; [ "$id" != type-check ] || id=typecheck; [ "$id" != test-e2e ] || id=e2e
    add "$id" "$pm $k" "package.json scripts.$k"
  done
  # 큰 저장소는 전체 테스트가 길고 이미 깨진 테스트가 섞인다. 바뀐 파일과 관련된 테스트만 도는 명령도 보여 준다.
  if jq -e '(.dependencies.jest // .devDependencies.jest) != null' package.json > /dev/null 2>&1; then
    add test-related "npx jest --findRelatedTests <바뀐 파일>" "package.json jest"
  elif jq -e '(.dependencies.vitest // .devDependencies.vitest) != null' package.json > /dev/null 2>&1; then
    add test-related "npx vitest related --run <바뀐 파일>" "package.json vitest"
  fi
fi
if [ -f Makefile ]; then
  for k in test lint check build; do
    ! grep -Eq "^$k:" Makefile || add "$k" "make $k" "Makefile"
  done
fi
if [ -f pyproject.toml ] || [ -f pytest.ini ] || [ -f setup.cfg ] || ls tests/test_*.py > /dev/null 2>&1; then
  if grep -qs pytest pyproject.toml pytest.ini setup.cfg requirements*.txt || ls tests/test_*.py > /dev/null 2>&1; then
    add test "pytest" "pytest 설정/tests"
  fi
  ! grep -qs ruff pyproject.toml || add lint "ruff check ." "pyproject.toml ruff"
fi
[ ! -f go.mod ] || { add test "go test ./..." "go.mod"; add lint "go vet ./..." "go.mod"; }
[ ! -f Cargo.toml ] || { add test "cargo test" "Cargo.toml"; add lint "cargo clippy -- -D warnings" "Cargo.toml"; }
[ ! -x gradlew ] || add test "./gradlew test" "gradlew"
[ ! -f tests/run-all.sh ] || add test "bash tests/run-all.sh" "tests/run-all.sh"
[ ! -f tests/run.sh ] || add test "bash tests/run.sh" "tests/run.sh"
if [ -n "$(find . -maxdepth 3 -name "*.bats" -not -path "./node_modules/*" -print -quit 2> /dev/null)" ]; then
  add test "bats -r ." "*.bats 파일"
fi
[ ! -f Package.swift ] || { add test "swift test" "Package.swift"; add build "swift build" "Package.swift"; }
# 저장소에 이미 있는 실행 스크립트(scripts/ 아래, 하네스 것과 source용 .sh는 뺀다). 팀이 감싸 둔 도구가 있으면 그것을 쓴다.
for f in scripts/* scripts/*/*; do
  [ -f "$f" ] && [ -x "$f" ] || continue
  case "$f" in scripts/harness/* | *.sh) continue ;; esac
  add "$(basename "$f")" "$f" "저장소 스크립트"
done

# --- 생성 파일·보호할 파일의 단서 ------------------------------------------------------------
# 정하지 않고 보여 주기만 한다. 맞는지는 사용자에게 묻는다.
hints=()
hint() { hints+=("$1"); }
if [ -f Project.swift ] || [ -f Workspace.swift ] || [ -d Tuist ]; then
  hint "Tuist manifest가 있다 → *.xcodeproj/*, *.xcworkspace/*, Derived/*, */Derived/*가 생성물일 수 있다. 테스트는 tuist test나 xcodebuild"
elif [ -f project.yml ]; then
  hint "XcodeGen 설정(project.yml)이 있다 → *.xcodeproj/*가 생성물일 수 있다"
elif [ -n "$(find . -maxdepth 2 -name "*.xcodeproj" -not -path "./node_modules/*" -print -quit 2> /dev/null)" ]; then
  hint "Xcode 프로젝트가 있다 → project.pbxproj는 손으로 고치면 깨지기 쉽다. 막을지 묻는다. 빌드·테스트는 xcodebuild -scheme <스킴> (스킴·시뮬레이터는 묻는다)"
fi
if [ -f package.json ] && jq -e '(.dependencies.expo // .devDependencies.expo) != null' package.json > /dev/null 2>&1; then
  for d in ios android; do
    ! git check-ignore -q "$d/" 2> /dev/null || hint "Expo이고 ${d}/를 git이 무시한다 → prebuild 생성물일 수 있다: $d/*"
  done
fi
for f in openapi.yaml openapi.json schema.graphql codegen.yml codegen.ts; do
  [ ! -f "$f" ] || hint "${f}가 있다 → 이것으로 만든 코드가 생성물일 수 있다"
done

common_checks=""
[ ! -f "$here/common-checks.json" ] \
  || common_checks="$(jq -r '.checks[] | "  - \(.name)\t\(.description)"' "$here/common-checks.json")"$'\n'

echo "[harness setup] 이 프로젝트($root)의 하네스 설정을 사용자와 대화로 정한다."
echo "하네스는 이 저장소가 어떤 도구를 쓰는지 모른다. 아래는 단서일 뿐이고, 정하는 것은 사용자의 답이다."
if [ -f "$checks_json" ]; then
  echo "이미 검사 목록이 있다. 먼저 지금 검사(name·description)와 project.json의 generated를 보여 주고 바꿀 부분만 묻는다."
fi
echo
echo "하네스가 추천하는 검사 (scripts/harness/common-checks.json에 prompt·run이 있다):"
if [ -n "$common_checks" ]; then printf '%s' "$common_checks" | column -t -s $'\t'; else echo "  (없다)"; fi
echo
echo "저장소에서 찾은 검사 명령:"
if [ ${#found[@]} -eq 0 ]; then
  echo "  (찾지 못했다 — 무엇으로 테스트·린트·빌드하는지 사용자에게 묻는다)"
else
  printf '%s\n' "${found[@]}" | awk -F'\t' '!seen[$2]++ { printf "  - %-10s %-28s (근거: %s)\n", $1, $2, $3 }'
fi
echo
echo "생성 파일·보호할 파일의 단서:"
if [ ${#hints[@]} -eq 0 ]; then echo "  (없다)"; else printf '  - %s\n' "${hints[@]}"; fi
cat <<'EOF'

진행 순서
1. AskUserQuestion으로 묻는다. 한 번에 4개까지 물을 수 있다. 추천하는 것은 라벨 끝에 "(Recommended)"를 붙이고
   저장소 근거를 한 줄 붙인다. 답이 애매하거나 사용자가 덧붙이면 이어서 묻는다. 정할 것이 다 정해질 때까지 주고받는다.
   ① 작업마다 고를 수 있게 둘 검사 (multiSelect): 위의 추천 검사와 찾은 명령. 찾은 것이 없거나 모자라면
      "빌드·테스트·린트를 어떤 명령으로 돌리나요?"를 묻는다. 1분 넘게 걸리는 것(e2e 등)은 그렇다고 적는다.
   ② 자동 생성 파일: 단서가 있으면 그 글롭을 선택지로 낸다. 없으면 "도구가 만들어 내는 파일(직접 고치면 다시 만들 때 사라지는 것)이 있나요?"
   ③ 에이전트가 직접 고치면 안 되는 파일: 단서가 있으면 선택지로 낸다(예: project.pbxproj). 없으면 "없음"을 추천한다.
   ④ 출력이 너무 길거나 여러 단계를 거쳐야 하는 명령: 있으면 감싸는 스크립트를 이 저장소에 만들어 줄지 묻는다.
2. 답으로 쓴다.
   - 검사 → .harness/checks.json. 형식은 schemaVersion 1과 checks 배열이다(하네스 저장소의 docs/checks.md).
     추천 검사는 common-checks.json의 항목을 그대로 옮긴다. 다른 명령은 이렇게 쓴다. 검사는 훅에서 돌리지 않고 에이전트가 record로 돌린다. run은 결과만 본다:
       { "name": "test", "description": "단위 테스트 (npm test)",
         "prompt": "scripts/harness/record test \"npm test\"를 실행하고 통과할 때까지 고친다",
         "run": "scripts/harness/passed test" }
     e2e처럼 범위를 고를 수 있는 것은 이번 수정에 영향받는 것만 돌리게 prompt에 적는다.
     회귀 묶음(늘 확인할 시나리오 모음)이 있으면 regression 검사를 따로 둔다. 배포 전·리팩터링 뒤에 사용자가 고르는 검사다.
       { "name": "regression", "description": "회귀 묶음 전체 (배포 전·리팩터링 뒤에 고른다)",
         "prompt": "scripts/harness/record regression \"<회귀 묶음 명령>\"을 실행하고, 실패하면 이번 변경 때문인지 먼저 확인한 뒤 고친다",
         "run": "scripts/harness/passed regression" }
     순서: 파일을 고치는 검사(포매터, --fix) → 싸고 빠른 검사 → 리뷰 → e2e.
   - 생성 파일 → .harness/project.json의 "generated" 배열(글롭, 프로젝트 루트 기준). *는 /도 넘는다. 예: ["ios/*", "*.xcodeproj/*"].
     훅이 이 파일의 편집을 막고, 리뷰어가 열지 않아도 되는 파일로 친다.
   - 직접 고치면 안 되는 파일 → .claude/settings.json의 permissions.deny에 "Edit(<글롭>)"을 더한다. 예: "Edit(**/*.pbxproj)".
     Edit 규칙은 파일을 고치는 도구 모두에 걸린다. 하네스를 갱신해도 팀이 넣은 규칙은 남는다.
   - 감싸는 스크립트 → 이 저장소의 scripts/ 아래(scripts/harness/는 하네스가 관리하니 피한다). 성공하면 한 줄, 실패하면 첫 에러 위치를 보여 주고
     전체 로그는 파일로 남긴다. 검사에서는 scripts/harness/record <이름> <그 스크립트>로 부른다. 이 저장소의 코드라 하네스가 갱신하지 않는다.
   - 정한 빌드·테스트 명령 → AGENTS.md 위쪽 프로젝트 영역의 "빌드·테스트" 칸.
   - 팀 코딩 규칙이 있다고 하면 .claude/rules/project/<이름>.md에 paths를 달아 둔다(하네스 저장소의 docs/template.md).
3. scripts/harness/doctor가 문제를 내지 않는지 확인한다. 쓴 내용을 사용자에게 보여 주고, 커밋해야 한다고 알린다.

AskUserQuestion을 쓸 수 없는 세션이면 묻지 말고 하네스 추천 검사만으로 checks.json을 쓴다. 다른 설정은 쓰지 않는다.
EOF
