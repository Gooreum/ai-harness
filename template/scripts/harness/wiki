#!/usr/bin/env bash
# 정책·결정 기록(docs/wiki/)을 찾고 형식을 검사한다. 검색 기록은 .harness/state/wiki-search.log에 남긴다.
# stats는 플러그인 훅(wiki-use.sh)이 세션별로 남긴 검색·열람(.harness/state/wiki-use.jsonl)을 비교한다.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

usage() {
  cat <<'EOF2'
사용법: scripts/harness/wiki search <단어>...
       scripts/harness/wiki check [파일...]
       scripts/harness/wiki done
       scripts/harness/wiki stats

  search   docs/wiki/의 기록 중 모든 단어가 들어 있는 것을 찾는다(대소문자 무시).
           한 줄에 하나씩 "종류  경로  제목"을 출력한다. 내용은 그 파일을 열어 읽는다.
  check    기록의 형식(kind, tags, 제목, 종류별 항목)을 검사한다. 파일을 주지 않으면 전부.
  done     마무리 단계의 확인(checks.json의 stages.finish.run). 이번 작업에서 docs/wiki/를 바꿨으면
           바꾼 기록의 형식을 검사한다. 바꾸지 않았으면 남기지 않은 이유(.harness/state/wiki.skip)가 있어야 한다.
  stats    에이전트가 위키를 검색하고 연 기록(.harness/state/wiki-use.jsonl)을 센다. 결과가 있었는데
           아무것도 열지 않은 검색과, 검색에 걸린 기록마다 걸린 뒤 열린 횟수를 보여 준다.

  종료 코드: search는 찾으면 0, 없으면 1. check·done은 문제가 없으면 0, 있으면 1. stats는 0(기록이 깨졌으면 1). 인자 오류 2
EOF2
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
cmd="$1"; shift
harness_init
wiki_dir="$root/docs/wiki"

case "$cmd" in
  search)
    [ $# -ge 1 ] || harness_die "search에 찾을 단어가 필요합니다"
    hits=""
    if [ -d "$wiki_dir" ]; then
      hits="$(cd "$root" && find docs/wiki -name '*.md' -type f | LC_ALL=C sort)"
      for word in "$@"; do
        [ -n "$hits" ] || break
        hits="$(cd "$root" && printf '%s\n' "$hits" | while IFS= read -r f; do grep -qiF -- "$word" "$f" && echo "$f"; done || true)"
      done
    fi
    count="$(printf '%s' "$hits" | grep -c . || true)"
    printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" "$count" >> "$state_dir/wiki-search.log"
    if [ "$count" -eq 0 ]; then
      echo "· wiki · \"$*\"에 맞는 기록 없음"
      exit 1
    fi
    printf '%s\n' "$hits" | while IFS= read -r f; do
      printf '%s\t%s\t%s\n' "$(wiki_kind "$root/$f")" "$f" "$(wiki_title "$root/$f")"
    done
    ;;
  check)
    if [ $# -eq 0 ]; then
      [ -d "$wiki_dir" ] || { echo "✓ wiki · 기록 없음"; exit 0; }
      set -- $(cd "$root" && find docs/wiki -name '*.md' -type f | LC_ALL=C sort)
      [ $# -gt 0 ] || { echo "✓ wiki · 기록 없음"; exit 0; }
    fi
    bad=0
    for f in "$@"; do
      case "$f" in /*) path="$f" ;; *) path="$root/$f" ;; esac
      [ -f "$path" ] || { echo "  ${f}: 파일이 없습니다"; bad=$((bad + 1)); continue; }
      problems="$(wiki_problems "$path")"
      # 기록은 저장소에 올려야 다음 작업에서 찾는다(발표 슬라이드 46). git이 무시하면 커밋되지 않는다.
      if ignored="$(git -C "$root" check-ignore -v -- "$path" 2> /dev/null)"; then
        problems="${problems:+$problems$'\n'}git이 무시하는 경로라 커밋되지 않습니다 ($(printf '%s' "$ignored" | cut -f1)). 폴더 이름을 바꾸거나 .gitignore를 고칩니다"
      fi
      if [ -n "$problems" ]; then
        printf '%s\n' "$problems" | sed "s|^|  ${f#"$root"/}: |"
        bad=$((bad + 1))
      fi
    done
    if [ "$bad" -eq 0 ]; then
      echo "✓ wiki · 기록 $#개"
    else
      echo "✗ wiki · 기록 $#개 중 ${bad}개에 문제" >&2
      exit 1
    fi
    ;;
  done)
    # 마무리 단계에서 위키 기록을 건너뛰지 못하게 한다(ADR 0032). 바뀐 파일은 시작 커밋(task.base)부터 본다.
    # 시작 커밋이 없으면(git 저장소가 아니거나 커밋 전) 무엇이 바뀌었는지 알 수 없다. 판단할 수 없으면 막지 않는다.
    # harness_task_base는 진행 중인 작업이 있고 시작 커밋이 저장소에 있을 때만 값을 낸다.
    if [ -z "$(harness_task_base)" ]; then
      echo "· wiki · 진행 중인 작업의 시작 커밋(.harness/state/task.base)이 없어 확인하지 않음"
      exit 0
    fi
    # 커밋한 것, 커밋하지 않은 것, 새로 만든 것을 모두 센다. 커밋했는지는 Stop 훅이 따로 확인한다.
    # harness_changed_files는 프로젝트 루트 기준 경로를 낸다(하위 폴더 설치, 한글 경로). 작업 전부터 있던 추적 안 된 파일은 뺀다.
    changed="$(harness_changed_files | grep '^docs/wiki/.*\.md$' || true)"
    if [ -n "$changed" ]; then
      kept=0 bad=0
      while IFS= read -r f; do
        [ -f "$root/$f" ] || continue
        kept=$((kept + 1))
        out="$("$0" check "$f" 2> /dev/null)" || { printf '%s\n' "$out"; bad=$((bad + 1)); }
      done <<< "$changed"
      if [ "$bad" -gt 0 ]; then
        echo "✗ wiki · 이번에 바꾼 기록 ${kept}개 중 ${bad}개에 문제. 형식을 고친 뒤 scripts/harness/wiki check로 다시 확인한다" >&2
        exit 1
      fi
      if [ "$kept" -gt 0 ]; then
        echo "✓ wiki · 이번에 바꾼 기록 ${kept}개"
      else
        echo "✓ wiki · 기록 $(printf '%s\n' "$changed" | grep -c .)개를 지움"
      fi
      exit 0
    fi
    skip="$state_dir/wiki.skip"
    if [ -s "$skip" ] && grep -q '[^[:space:]]' "$skip"; then
      echo "✓ wiki · 이번 작업은 기록하지 않음: $(grep -m1 '[^[:space:]]' "$skip")"
      exit 0
    fi
    # git이 무시하는 곳에 쓴 기록은 바뀐 것으로 잡히지 않는다. 원인을 알 수 있게 따로 알린다.
    ignored_new="$(cd "$root" && git -c core.quotePath=false ls-files --others --ignored --exclude-standard -- docs/wiki | grep '\.md$' || true)"
    if [ -n "$ignored_new" ]; then
      echo "✗ wiki · git이 무시하는 경로에 쓴 기록이 있어 커밋되지 않는다:" >&2
      printf '%s\n' "$ignored_new" | sed -n '1,5p' | sed 's/^/    /' >&2
      echo "  폴더 이름을 바꾸거나 .gitignore를 고친 뒤 scripts/harness/wiki check로 확인한다" >&2
      exit 1
    fi
    cat >&2 <<'EOF2'
✗ wiki · 이번 작업에서 docs/wiki/를 바꾸지 않았고, 남기지 않은 이유(.harness/state/wiki.skip)도 없다
  이번에 정한 정책·결정이나 알게 된 사실이 있으면 docs/wiki/에 기록하고 scripts/harness/wiki check를 돌린다.
  남길 것이 없으면 그 이유를 한 줄로 .harness/state/wiki.skip에 쓴다. 작업 보고의 "5. 위키"에 이 이유를 옮긴다.
EOF2
    exit 1
    ;;
  stats)
    # 발표 슬라이드 52의 "검색 → 열람"을 잰다. 반영은 재지 않는다.
    # 검색 결과가 있었는데 같은 세션에서 그 뒤로 걸린 기록을 하나도 열지 않았으면 "열지 않은 검색"으로 센다.
    log="$state_dir/wiki-use.jsonl"
    if [ ! -s "$log" ]; then
      echo "· wiki · 검색·열람 기록 없음 (.harness/state/wiki-use.jsonl, 플러그인 훅이 남긴다)"
      exit 0
    fi
    jq -rs '
      [ to_entries[] | .value + {i: .key} | select(.session and .event) ] as $ev
      | [ $ev[] | select(.event == "search") ] as $searches
      | [ $ev[] | select(.event == "open") ] as $opens
      | [ $searches[] | select((.hits // []) | length > 0)
          | . as $s
          | . + {opened: ([ $opens[] | select(.session == $s.session and .i > $s.i and (.path as $p | $s.hits | index($p))) ] | length > 0)} ] as $hit
      | [ $hit[] | select(.opened | not) ] as $missed
      | ([ $ev[].session ] | unique | length) as $sessions
      | "wiki · 세션 \($sessions)개 · 검색 \($searches | length)회(결과 있음 \($hit | length)) · 열람 \($opens | length)회",
        (if ($missed | length) == 0 then "  결과가 있었던 검색은 모두 걸린 기록을 하나 이상 열었다"
         else "  결과가 있었는데 아무것도 열지 않은 검색 \($missed | length)회 (최근 10개):",
           ($missed | .[-10:] | reverse[] | "    \(.t)  \"\(.query)\"  → \(.hits[0])\(if (.hits | length) > 1 then " 외 \((.hits | length) - 1)개" else "" end)")
         end),
        (if ($hit | length) == 0 then empty else
           "  검색에 걸린 기록 (걸린 횟수 / 그 뒤 열린 횟수, 많이 걸린 순 10개):",
           ( [ $hit[] as $s | $s.hits[] as $p
               | {p: $p, opened: ([ $opens[] | select(.session == $s.session and .i > $s.i and .path == $p) ] | length > 0)} ]
             | group_by(.p) | map({p: .[0].p, n: length, o: (map(select(.opened)) | length)})
             | sort_by(-.n, .p) | .[:10][] | "    \(.n) / \(.o)  \(.p)" )
         end)
    ' "$log" 2> /dev/null || { echo "✗ wiki · .harness/state/wiki-use.jsonl을 읽지 못했다(JSON이 깨졌을 수 있다)" >&2; exit 1; }
    ;;
  -h|--help) usage ;;
  *) echo "wiki: 알 수 없는 명령: $cmd" >&2; usage >&2; exit 2 ;;
esac
