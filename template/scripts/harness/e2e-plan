#!/usr/bin/env bash
# 계획에서 정한 e2e 시나리오를 쓰고, 고른 e2e 검사가 그 시나리오를 돌렸는지 확인한다(ADR 0033).
#   plan        계획서(.harness/state/plan.md)에 e2e 판단 줄이 형식대로 있는지 (checks.json stages.plan.run)
#   written     계획한 시나리오를 이번 작업에서 쓰거나 고쳤는지 (stages.implement.run)
#   ran <검사>  그 e2e 검사가 계획한 시나리오와 아직 돌리지 않은 시나리오를 돌렸는지 (e2e 검사 run에 && 로 잇는다)
#   list        이번에 돌릴 시나리오 목록
#
# e2e를 돌릴지는 사람이 정한다. 작업을 시작할 때 e2e 검사를 고르지 않았으면 시나리오를 쓰기만 하고 돌리지 않는다.
# 그렇게 쓴 시나리오는 .harness/e2e-unrun에 남는다. 다음에 e2e 검사를 고른 작업에서 함께 돌려야 통과한다.
# 하네스는 e2e 도구를 모른다. 시나리오 폴더(project.json의 e2e.scenarios)와 e2e 검사 표시(checks.json의 "e2e": true)만 본다.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

usage() {
  cat <<'EOF2'
사용법: scripts/harness/e2e-plan plan | written | ran <검사 이름> | list

  plan     계획서에 "- e2e 판단: 필요|기존 수정|불필요 (기준 번호) 이유" 줄이 있는지 본다.
           필요·기존 수정이면 "- e2e 시나리오: <경로>" 줄이, e2e 검사를 고르지 않았으면 "- e2e 실행: 안 함" 줄이 있어야 한다.
  written  계획한 시나리오 파일이 있고 이번 작업에서 쓰거나 고쳤는지 본다.
           e2e 검사를 고르지 않았으면 그 시나리오를 .harness/e2e-unrun에 남긴다.
  ran      그 검사의 결과(.harness/out/<검사>.json)의 실행 명령에 돌려야 할 시나리오(또는 그 폴더)가 있는지 본다.
           통과하면 돌린 시나리오를 .harness/e2e-unrun에서 지운다.
  list     돌려야 할 시나리오(계획한 것과 .harness/e2e-unrun)를 한 줄에 하나씩 출력한다.

  project.json에 e2e.scenarios가 없으면 아무것도 확인하지 않는다. 계획서가 없으면(simple 모드) 계획 확인을 건너뛴다.
  종료 코드: 통과 0, 확인 실패 1, 인자 오류 2
EOF2
}

[ $# -ge 1 ] || { usage >&2; exit 2; }
cmd="$1"
shift
case "$cmd" in
  -h | --help) usage; exit 0 ;;
  plan | written | ran | list) ;;
  *) usage >&2; exit 2 ;;
esac
harness_init

scen="$(cfg '.e2e.scenarios')"
scen="${scen%/}"
if [ -z "$scen" ]; then
  [ "$cmd" = list ] || echo "· e2e-plan · project.json에 e2e.scenarios가 없어 확인하지 않음"
  exit 0
fi
plan="$state_dir/plan.md"
unrun="$root/.harness/e2e-unrun"
checks_file="$root/.harness/checks.json"

fail() {
  echo "✗ e2e-plan · $*"
  exit 1
}

# 판단 줄: "- e2e 판단: 필요|기존 수정|불필요 (N1, N4) 이유"
judge_line() { grep -E '^[[:space:]]*- e2e 판단:' "$plan" | head -1 || true; }
judge_kind() { judge_line | sed -nE 's/.*e2e 판단:[[:space:]]*(필요|기존 수정|불필요)[[:space:]]*\(.*/\1/p'; }
planned() {
  [ -f "$plan" ] || return 0
  [ "$(judge_kind)" != 불필요 ] || return 0
  sed -nE 's/^[[:space:]]*- e2e 시나리오:[[:space:]]*([^[:space:]]+).*/\1/p' "$plan"
}
# 필요면 시나리오마다 그 아래 들여쓴 줄에 시작점·동작·확인이 있어야 한다. 빠진 첫 시나리오와 항목을 출력한다.
missing_detail() {
  awk '
    function check() { if (cur != "" && !found) for (i = 1; i <= 3; i++) if (!(w[i] in seen)) { print cur " " w[i]; found = 1; return } }
    BEGIN { w[1] = "시작점"; w[2] = "동작"; w[3] = "확인" }
    /^[[:space:]]*- e2e 시나리오:/ { check(); cur = $0; sub(/.*e2e 시나리오:[[:space:]]*/, "", cur); sub(/[[:space:]].*/, "", cur); delete seen; next }
    /^[[:space:]]+- / && cur != "" { for (i = 1; i <= 3; i++) if ($0 ~ "^[[:space:]]+- " w[i] ":") seen[w[i]] = 1; next }
    /^[^[:space:]]/ || /^[[:space:]]*- / { check(); cur = "" }
    END { check() }' "$plan"
}
# 이번 작업에서 고른 검사 중 e2e 검사(checks.json에서 "e2e": true)
selected_e2e() {
  [ -f "$state_dir/task.json" ] && [ -f "$checks_file" ] || return 0
  jq -r --slurpfile t "$state_dir/task.json" \
    '[.checks // [] | .[] | select(.e2e == true) | .name] as $e | ($t[0].checks // [])[] | select(. as $n | $e | index($n))' \
    "$checks_file" 2> /dev/null || true
}
unrun_list() {
  [ -f "$unrun" ] || return 0
  grep -v '^[[:space:]]*$' "$unrun" || true
}
# 경로 $1이 실행 명령의 인자 중 하나와 같거나 그 폴더 아래에 있으면 참
in_command() {
  local f="$1" tok
  for tok in $2; do
    tok="${tok#./}"
    tok="${tok%/}"
    [ -n "$tok" ] || continue
    case "$f" in "$tok" | "$tok"/*) return 0 ;; esac
  done
  return 1
}
oneline() { tr '\n' ' ' | sed 's/ $//'; }

case "$cmd" in
  plan)
    [ -f "$plan" ] || fail "계획서(.harness/state/plan.md)가 없다. 계획을 ExitPlanMode로 승인받으면 하네스가 저장한다"
    line="$(judge_line)"
    [ -n "$line" ] || fail '계획에 "- e2e 판단: 필요|기존 수정|불필요 (기준 번호) 이유" 줄이 없다. 지시에 들어 있는 e2e 판단 기준으로 정해 적는다'
    kind="$(judge_kind)"
    [ -n "$kind" ] || fail "판단은 필요, 기존 수정, 불필요 중 하나이고 그 뒤에 (기준 번호)가 와야 한다: $line"
    printf '%s' "$line" | grep -Eq '\(([NU][0-9]+)([[:space:]]*,[[:space:]]*[NU][0-9]+)*\)[[:space:]]*[^[:space:]]' \
      || fail "기준 번호를 (N1)이나 (N1, N4)처럼 쓰고 그 뒤에 이유를 한 줄 쓴다: $line"
    list="$(planned)"
    if [ "$kind" = 불필요 ]; then
      grep -Eq '^[[:space:]]*- e2e 시나리오:' "$plan" && fail "불필요로 판단했는데 시나리오 줄이 있다"
      printf '%s' "$line" | grep -Eq '\(U[0-9]+([[:space:]]*,[[:space:]]*U[0-9]+)*\)' || fail "불필요의 근거는 U 기준 번호만 쓴다: $line"
      echo "✓ e2e-plan · 불필요"
      exit 0
    fi
    [ -n "$list" ] || fail "${kind} 판단이면 \"- e2e 시나리오: ${scen}/<파일>\" 줄을 시나리오마다 쓴다"
    while IFS= read -r f; do
      case "$f" in "$scen"/?*) ;; *) fail "시나리오는 ${scen}/ 아래 경로로 쓴다: $f" ;; esac
    done <<< "$list"
    if [ "$kind" = 필요 ]; then
      gap="$(missing_detail)"
      [ -z "$gap" ] || fail "필요면 시나리오마다 그 아래에 시작점, 동작, 확인을 쓴다. 빠진 것: $gap"
    fi
    if [ -z "$(selected_e2e)" ]; then
      grep -Eq '^[[:space:]]*- e2e 실행:[[:space:]]*안 함' "$plan" \
        || fail "e2e 검사를 고르지 않았다. 시나리오는 쓰고 돌리지 않는다. 계획에 \"- e2e 실행: 안 함 (검사를 고르지 않음)\" 줄을 쓴다. 돌릴지는 사용자가 승인 창에서 정한다"
    fi
    echo "✓ e2e-plan · $kind ($(printf '%s\n' "$list" | oneline))"
    ;;
  written)
    if [ ! -f "$plan" ]; then
      echo "· e2e-plan · 계획서가 없어 건너뜀(simple 모드)"
      exit 0
    fi
    list="$(planned)"
    if [ -z "$list" ]; then
      echo "· e2e-plan · 계획한 시나리오 없음"
      exit 0
    fi
    if [ -z "$(harness_task_base)" ]; then
      echo "· e2e-plan · 진행 중인 작업의 시작 커밋(.harness/state/task.base)이 없어 확인하지 않음"
      exit 0
    fi
    changed="$(harness_changed_files)"
    while IFS= read -r f; do
      [ -f "$root/$f" ] || fail "계획한 시나리오를 아직 쓰지 않았다: $f. 계획서의 시작점·동작·확인대로 이 단계에서 쓴다"
      printf '%s\n' "$changed" | grep -qxF "$f" || fail "계획한 시나리오를 이번 작업에서 쓰거나 고치지 않았다: $f"
    done <<< "$list"
    if [ -z "$(selected_e2e)" ]; then
      # 사용자가 e2e를 고르지 않았다. 돌리지 않은 시나리오로 남겨 다음에 e2e를 고른 작업에서 돌리게 한다.
      { unrun_list; printf '%s\n' "$list"; } | LC_ALL=C sort -u > "$unrun.tmp" && mv "$unrun.tmp" "$unrun"
      echo "✓ e2e-plan · 시나리오를 썼다($(printf '%s\n' "$list" | oneline)). e2e 검사를 고르지 않아 돌리지 않고 .harness/e2e-unrun에 남겼다"
    else
      echo "✓ e2e-plan · 시나리오를 썼다($(printf '%s\n' "$list" | oneline))"
    fi
    ;;
  list)
    { planned; unrun_list; } | awk 'NF && !seen[$0]++'
    ;;
  ran)
    name="${1:-}"
    [ -n "$name" ] || { usage >&2; exit 2; }
    case "$name" in */* | .*) harness_die "검사 이름에 경로를 쓸 수 없습니다: $name" ;; esac
    # 지운 시나리오는 돌릴 수 없으니 뺀다.
    need="$({ planned; unrun_list; } | awk 'NF && !seen[$0]++' | while IFS= read -r f; do [ -f "$root/$f" ] && printf '%s\n' "$f"; done || true)"
    if [ -z "$need" ]; then
      [ ! -f "$unrun" ] || rm -f "$unrun"
      echo "· e2e-plan · 돌려야 할 시나리오 없음"
      exit 0
    fi
    result="$out_dir/$name.json"
    [ -f "$result" ] || fail "결과(.harness/out/$name.json)가 없다. 검사 ${name}의 prompt대로 scripts/harness/record로 돌린다"
    command="$(jq -r '.command // ""' "$result")"
    missing=""
    while IFS= read -r f; do
      in_command "$f" "$command" || missing="$missing $f"
    done <<< "$need"
    if [ -n "$missing" ]; then
      fail "검사 ${name}의 실행 명령($command)에 돌려야 할 시나리오가 없다:${missing}. 시나리오 파일이나 ${scen}/를 명령에 넣어 다시 record한다(scripts/harness/e2e-plan list로 목록을 본다)"
    fi
    if [ -f "$unrun" ]; then
      left="$(unrun_list | while IFS= read -r f; do [ -f "$root/$f" ] && ! printf '%s\n' "$need" | grep -qxF "$f" && printf '%s\n' "$f"; done || true)"
      if [ -n "$left" ]; then printf '%s\n' "$left" > "$unrun"; else rm -f "$unrun"; fi
    fi
    echo "✓ e2e-plan · 돌린 시나리오: $(printf '%s\n' "$need" | oneline)"
    ;;
esac
