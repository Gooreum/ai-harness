#!/usr/bin/env bash
# Maestro 시나리오(.maestro/)를 시뮬레이터에서 돌리고 흐름별 결과를 요약한다.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

usage() {
  cat <<'EOF'
사용법: scripts/harness/e2e [--tag 태그] [--no-build] [--record] [시나리오 파일...]

  앱을 빌드해 시뮬레이터에 설치하고 Maestro 시나리오를 돌린다.
  파일을 주지 않으면 .maestro/ 바로 아래의 시나리오를 모두 돌린다(하위 폴더는 runFlow로 부르는 공통 흐름).

  --tag 태그     이 태그가 붙은 시나리오만 (예: --tag regression)
                 tags: [network](가짜 응답 서버가 필요한 시나리오)는 파일을 직접 주거나 --tag network일 때만 돈다
  --no-build     빌드하지 않고 이미 빌드된 앱을 설치한다
  --record       시뮬레이터 화면을 .harness/out/e2e.mp4로 녹화한다 (PR에 수정 전후 영상 첨부용)

  시나리오는 appId: ${APP_ID}로 쓴다. 값은 .harness/project.json의 app.bundleId다.
  계정 같은 비밀 값은 MAESTRO_로 시작하는 환경 변수로 넘긴다(Maestro가 그대로 읽는다).
  행동 로그: 시나리오 옆에 <이름>.events.json을 두면 그 흐름 동안 나간 이벤트를 판정한다.
  .harness/project.json의 e2e.events가 "firebase"일 때 쓸 수 있다.
  서버 응답 바꾸기: e2e.network.port가 있으면 maestro에 NETWORK_BASE_URL(가짜 응답 서버 주소)을 넘긴다.

산출물 (.harness/out/): e2e.json(흐름별 결과), e2e.log, e2e-junit.xml, e2e/(스크린샷·로그), e2e.mp4(--record),
                       e2e-events.ndjson(행동 로그)
종료 코드: 통과 0, 실패한 시나리오가 있으면 1, 설정·도구 문제 2
EOF
}

tag=""
all_flows=0
build=1
record=0
flows=()
while [ $# -gt 0 ]; do
  case "$1" in
    --tag) [ $# -ge 2 ] || harness_die "--tag에 태그가 필요합니다"; tag="$2"; shift ;;
    --no-build) build=0 ;;
    --record) record=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "e2e: 알 수 없는 인자: $1" >&2; usage >&2; exit 2 ;;
    *) flows+=("$1") ;;
  esac
  shift
done

harness_init
command -v maestro >/dev/null 2>&1 || harness_die "maestro가 필요합니다 (curl -fsSL https://get.maestro.mobile.dev | bash)"
e2e_java_ok || harness_die "Maestro가 쓸 Java가 없습니다. JDK를 설치하고(brew install openjdk@17) JAVA_HOME을 지정하세요"
bundle_id="$(cfg .app.bundleId)"
events_source="$(cfg .e2e.events)"
network_port="$(cfg .e2e.network.port)"
case "$events_source" in ""|firebase) ;; *) harness_die "e2e.events는 firebase만 지원합니다: $events_source" ;; esac
[ -n "$bundle_id" ] || harness_die "설정에 app.bundleId가 없습니다"
if [ ${#flows[@]} -eq 0 ]; then
  [ -d "$root/.maestro" ] || harness_die ".maestro/에 시나리오가 없습니다. 작성 규칙은 .claude/rules/harness/maestro.md에 있습니다"
  flows=("$root/.maestro")
  all_flows=1
fi
result="$out_dir/e2e.json"
rm -f "$result"
start=$SECONDS

# --- 기기와 앱 -----------------------------------------------------------------

harness_destination
udid="${destination#id=}"
# 다른 워크트리가 같은 기기로 e2e를 돌리는 중이면 같은 런타임의 다른 iPhone을 쓴다.
trap harness_release_simulator EXIT
sim_busy_owner=""
claimed=""
while read -r cand_udid cand_name; do
  [ -n "$cand_udid" ] || continue
  if harness_claim_simulator "$cand_udid"; then
    claimed="$cand_udid"
    [ "$cand_udid" = "$udid" ] || echo "· e2e · ${destination_label}을 다른 워크트리(${sim_busy_owner})가 쓰고 있어 ${cand_name}을 씁니다" >&2
    udid="$cand_udid"
    destination_label="$cand_name"
    break
  fi
done < <(xcrun simctl list devices available -j 2>/dev/null | simulator_candidates "$udid")
[ -n "$claimed" ] || harness_die "같은 런타임의 iPhone 시뮬레이터를 모두 다른 워크트리가 쓰고 있습니다(${sim_busy_owner:-알 수 없음}). 그쪽 e2e가 끝난 뒤 다시 실행하세요"
xcrun simctl boot "$udid" >/dev/null 2>&1 || true
xcrun simctl bootstatus "$udid" -b >/dev/null 2>&1 || harness_die "시뮬레이터 ${destination_label}을 켜지 못했습니다"

if [ "$build" = 1 ]; then
  "$here/build" || exit $?
  # 빌드한 구성의 앱만 설치한다. app.scheme이 만드는 앱과 app.bundleId가 다르면, 다른 구성으로 예전에
  # 빌드된 앱을 설치해 바뀐 코드 없이 통과할 수 있다.
  scheme="$(cfg .app.scheme)"
  config="$(scheme_run_config "$scheme")"
  app="$(e2e_find_app "$derived_data" "$bundle_id" "$config")"
  [ -n "$app" ] || harness_die "스킴 ${scheme}이 빌드한 ${config:-앱} 중 번들 ID가 ${bundle_id}인 앱이 없습니다 (빌드된 앱: $(e2e_built_ids "$derived_data" "${config:-*}")). .harness/project.json의 app.scheme과 app.bundleId를 같은 앱으로 맞추세요"
else
  app="$(e2e_find_app "$derived_data" "$bundle_id")"
  [ -n "$app" ] || harness_die "빌드된 앱($bundle_id)을 찾지 못했습니다. --no-build 없이 다시 실행하세요"
  stale="$(e2e_stale_source "$app")"
  [ -z "$stale" ] || harness_die "빌드된 앱이 ${stale}보다 오래됐습니다. 바뀐 코드 없이 통과할 수 있어 멈춥니다. --no-build 없이 다시 실행하세요"
fi
xcrun simctl install "$udid" "$app" || harness_die "앱을 시뮬레이터에 설치하지 못했습니다: $app"

# --- 실행 ---------------------------------------------------------------------

junit="$out_dir/e2e-junit.xml"
log="$out_dir/e2e.log"
artifacts="$out_dir/e2e"
rm -rf "$junit" "$artifacts"
args=(--device "$udid" test -e "APP_ID=$bundle_id" --format JUNIT --output "$junit" --test-output-dir "$artifacts" --no-ansi)
[ -z "$tag" ] || args+=(--include-tags "$tag")
# 가짜 응답 서버가 필요한 시나리오(tags: [network])는 사용자가 원할 때만 돈다: 파일을 직접 주거나 --tag network.
if [ "$all_flows" = 1 ] && [ "$tag" != network ]; then
  args+=(--exclude-tags network)
fi

# 가짜 응답 서버(플러그인 MCP harness-network)의 주소. 시나리오는 launchApp.arguments의
# "-HarnessNetworkBaseURL": ${NETWORK_BASE_URL}로 앱에 넘긴다. 서버는 Claude Code 세션이 띄운다.
# 서버는 적힌 포트를 다른 폴더(같은 프로젝트의 다른 워크트리)가 쓰고 있으면 빈 포트로 띄우고 실제 포트를
# .harness/state/network.port에 남긴다. 그 포트에 서버가 떠 있으면 그것을 쓴다.
[ -z "$network_port" ] || network_port="$(e2e_network_port "$network_port")"
if [ -n "$network_port" ]; then
  args+=(-e "NETWORK_BASE_URL=http://127.0.0.1:$network_port")
  if ! nc -z 127.0.0.1 "$network_port" 2>/dev/null; then
    echo "· e2e · 가짜 응답 서버(127.0.0.1:$network_port)가 떠 있지 않습니다. 이 주소로 보내는 앱 요청은 연결에 실패합니다 (Claude Code 세션의 harness-network MCP가 띄운다)" >&2
  fi
fi

# 행동 로그: Maestro가 남기는 기기 로그는 debug 수준이 빠져 있어 따로 받는다.
events_log="$out_dir/e2e-events.ndjson"
rm -f "$events_log"
streamer=""
if [ "$events_source" = firebase ]; then
  xcrun simctl spawn "$udid" log stream --level debug --style ndjson \
    --predicate 'subsystem == "com.google.firebase.analytics"' > "$events_log" 2>/dev/null &
  streamer=$!
  sleep 1
fi

recorder=""
if [ "$record" = 1 ]; then
  rm -f "$out_dir/e2e.mp4"
  xcrun simctl io "$udid" recordVideo --force "$out_dir/e2e.mp4" >/dev/null 2>&1 &
  recorder=$!
  sleep 1
fi
set +e
(cd "$root" && maestro "${args[@]}" "${flows[@]}") > "$log" 2>&1
code=$?
set -e
if [ -n "$recorder" ]; then
  kill -INT "$recorder" 2>/dev/null || true
  wait "$recorder" 2>/dev/null || true
fi
if [ -n "$streamer" ]; then
  # 마지막 이벤트가 수집 서버에 올라갈 때까지 최대 20초 기다린다.
  for _ in $(seq 1 20); do
    last_event="$(e2e_firebase_events "$events_log" | jq 'map(.time) | max // 0')"
    e2e_firebase_uploads "$events_log" | jq -e --argjson t "$last_event" 'any(.[]; . >= $t)' >/dev/null && break
    sleep 1
  done
  kill "$streamer" 2>/dev/null || true
  wait "$streamer" 2>/dev/null || true
fi
elapsed=$((SECONDS - start))

if [ ! -s "$junit" ]; then
  echo "✗ e2e · Maestro가 결과를 남기지 못했습니다 · ${elapsed}s" >&2
  grep -v '^\s*$' "$log" | tail -n 15 >&2
  exit 2
fi

flows_json="$(e2e_junit_to_json "$junit")"

# 흐름마다 시작 시각(ms). 행동 로그·서버 응답 판정이 "그 흐름이 시작해서 다음 흐름이 시작하기 전까지"로 나눌 때 쓴다.
windows="[]"
while IFS=$'\t' read -r name file; do
  cmds="$(ls "$artifacts"/*/"$name"/commands.json 2>/dev/null | head -n 1)"
  [ -n "$cmds" ] || continue
  windows="$(jq --arg n "$name" --argjson w "$(e2e_flow_window "$cmds")" '. + [$w + {name: $n}]' <<<"$windows")"
done < <(jq -r '.[] | [.name, .file] | @tsv' <<<"$flows_json")

# --- 행동 로그 판정 -------------------------------------------------------------

# 흐름마다 <이름>.events.json이 있으면, 그 흐름이 시작해서 다음 흐름이 시작하기 전까지 나간 이벤트로 판정한다.
if [ -n "$streamer" ]; then
  events_all="$out_dir/e2e-events.json"
  uploads_all="$out_dir/e2e-uploads.json"
  e2e_firebase_events "$events_log" > "$events_all"
  e2e_firebase_uploads "$events_log" > "$uploads_all"
  while IFS=$'\t' read -r name file; do
    expect="$root/${file%.yaml}.events.json"
    [ -f "$expect" ] || continue
    from="$(jq --arg n "$name" '(map(select(.name == $n))[0].start) // empty' <<<"$windows")"
    if [ -z "$from" ]; then
      verdict='{"passed":false,"checks":[],"uploaded":null,"error":"흐름 기록(commands.json)이 없어 판정하지 못했습니다"}'
    else
      to="$(jq --argjson s "$from" '[.[].start | select(. > $s)] | min // 9e15' <<<"$windows")"
      jq --argjson s "$from" --argjson e "$to" '[.[] | select(.time >= $s and .time < $e)]' "$events_all" > "$out_dir/e2e-events-flow.json"
      verdict="$(e2e_check_events "$expect" "$out_dir/e2e-events-flow.json" "$uploads_all")"
      if [ "$(jq length "$events_all")" -eq 0 ]; then
        verdict="$(jq '. + {error: "이벤트 로그가 하나도 없습니다. launchApp arguments에 \"-FIRAnalyticsDebugEnabled\": true를 넣었는지 확인하세요"}' <<<"$verdict")"
      fi
    fi
    flows_json="$(jq --arg n "$name" --argjson v "$verdict" 'map(if .name == $n then . + {events: $v} else . end)' <<<"$flows_json")"
  done < <(jq -r '.[] | [.name, .file] | @tsv' <<<"$flows_json")
  rm -f "$out_dir/e2e-events-flow.json"
else
  while IFS= read -r file; do
    if [ -f "$root/${file%.yaml}.events.json" ]; then
      echo "· e2e · ${file%.yaml}.events.json이 있지만 project.json에 e2e.events가 없어 행동 로그는 판정하지 않습니다" >&2
    fi
  done < <(jq -r '.[].file' <<<"$flows_json")
fi

# --- 서버 응답 판정 -------------------------------------------------------------

# 흐름마다 <이름>.network.json이 있으면, 그 흐름 동안 가짜 응답 서버가 기대한 응답을 정말 줬는지 서버 기록으로 판정한다.
# 응답을 걸지 않았거나 서버가 꺼져 있어도 앱의 실패 화면은 똑같이 떠서, 화면만으로는 구분할 수 없다.
network_log="$root/.harness/state/network-requests.ndjson"
while IFS=$'\t' read -r name file; do
  expect="$root/${file%.yaml}.network.json"
  [ -f "$expect" ] || continue
  if [ -z "$network_port" ]; then
    echo "· e2e · ${file%.yaml}.network.json이 있지만 project.json에 e2e.network.port가 없어 서버 응답은 판정하지 않습니다" >&2
    continue
  fi
  from="$(jq --arg n "$name" '(map(select(.name == $n))[0].start) // empty' <<<"$windows")"
  if [ -z "$from" ]; then
    verdict='{"passed":false,"checks":[],"error":"흐름 기록(commands.json)이 없어 판정하지 못했습니다"}'
  else
    to="$(jq --argjson s "$from" '[.[].start | select(. > $s)] | min // 9e15' <<<"$windows")"
    verdict="$(e2e_check_network "$expect" "$network_log" "$from" "$to")"
  fi
  flows_json="$(jq --arg n "$name" --argjson v "$verdict" 'map(if .name == $n then . + {network: $v} else . end)' <<<"$flows_json")"
done < <(jq -r '.[] | [.name, .file] | @tsv' <<<"$flows_json")

jq --arg tag "$tag" --argjson code "$code" \
  '{ passed: ($code == 0 and (map(select(.status != "SUCCESS" or .events.passed == false or .network.passed == false)) | length) == 0),
     tag: (if $tag == "" then null else $tag end), flows: . }' <<<"$flows_json" > "$result"

total="$(jq '.flows | length' "$result")"
failed="$(jq '[.flows[] | select(.status != "SUCCESS" or .events.passed == false or .network.passed == false)] | length' "$result")"
video=""
[ "$record" = 0 ] || video=" · 영상 .harness/out/e2e.mp4"
checked="$(jq '[.flows[] | select(.events != null)] | length' "$result")"
[ "$checked" -eq 0 ] || video=" · 행동 로그 $checked$video"
checked="$(jq '[.flows[] | select(.network != null)] | length' "$result")"
[ "$checked" -eq 0 ] || video=" · 서버 응답 $checked$video"
if [ "$total" -eq 0 ]; then
  echo "✗ e2e · 돌린 시나리오가 없습니다${tag:+ (태그 $tag)} · ${elapsed}s"
  exit 1
fi
if jq -e .passed "$result" >/dev/null; then
  echo "✓ e2e · 통과 $total${tag:+ · 태그 $tag} · ${elapsed}s$video"
  exit 0
fi
echo "✗ e2e · 실패 $failed / $total${tag:+ · 태그 $tag} · ${elapsed}s$video"
jq -r --argjson max "$max_errors" '[.flows[] | select(.status != "SUCCESS" or .events.passed == false or .network.passed == false)][:$max][]
  | if .status != "SUCCESS" then "  \(.file): \(.failure // .status)"
    elif .network.passed == false then "  \(.file): 서버 응답 " + (.network.error // ([.network.checks[] | select(.ok | not)
        | "\(.match) \(.status) 응답이 없었다"] | join(", ")) + " — mock_set으로 응답을 걸고 돌린다 (받은 요청: \(.network.requests | join(", ") | if . == "" then "없음" else . end))")
    else "  \(.file): 행동 로그 " + (.events.error // ([.events.checks[] | select(.ok | not)
        | "\(.name)\(if .params == {} then "" else (.params | tostring) end) \(.actual)회 (기대 \(.expected)회)"]
        + (if .events.uploaded == false then ["수집 서버 업로드 확인 안 됨"] else [] end) | join(", "))) end' "$result"
echo "  스크린샷·로그: .harness/out/e2e/ · 전체 출력: .harness/out/e2e.log"
exit 1
