#!/usr/bin/env bash
# Maestro 시나리오(.maestro/)를 시뮬레이터에서 돌리고 흐름별 결과를 요약한다.
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
. "$here/lib.sh"

usage() {
  cat <<'EOF'
사용법: scripts/harness/e2e [--tag 태그] [--no-build] [--record] [시나리오 파일...]

  앱을 빌드해 시뮬레이터에 설치하고 Maestro 시나리오를 돌린다.
  파일을 주지 않으면 .maestro/ 바로 아래의 시나리오를 모두 돌린다(하위 폴더는 runFlow로 부르는 공통 흐름).

  --tag 태그     이 태그가 붙은 시나리오만 (예: --tag regression)
  --no-build     빌드하지 않고 이미 빌드된 앱을 설치한다
  --record       시뮬레이터 화면을 .harness/out/e2e.mp4로 녹화한다 (PR에 수정 전후 영상 첨부용)

  시나리오는 appId: ${APP_ID}로 쓴다. 값은 .harness/project.json의 app.bundleId다.
  계정 같은 비밀 값은 MAESTRO_로 시작하는 환경 변수로 넘긴다(Maestro가 그대로 읽는다).

산출물 (.harness/out/): e2e.json(흐름별 결과), e2e.log, e2e-junit.xml, e2e/(스크린샷·로그), e2e.mp4(--record)
종료 코드: 통과 0, 실패한 시나리오가 있으면 1, 설정·도구 문제 2
EOF
}

tag=""
build=1
record=0
flows=()
while [ $# -gt 0 ]; do
  case "$1" in
    --tag) [ $# -ge 2 ] || harness_die "--tag에 태그가 필요합니다"; tag="$2"; shift ;;
    --no-build) build=0 ;;
    --record) record=1 ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "e2e: 알 수 없는 인자: $1" >&2; usage >&2; exit 2 ;;
    *) flows+=("$1") ;;
  esac
  shift
done

harness_init
command -v maestro >/dev/null 2>&1 || harness_die "maestro가 필요합니다 (curl -fsSL https://get.maestro.mobile.dev | bash)"
bundle_id="$(cfg .app.bundleId)"
[ -n "$bundle_id" ] || harness_die "설정에 app.bundleId가 없습니다"
if [ ${#flows[@]} -eq 0 ]; then
  [ -d "$root/.maestro" ] || harness_die ".maestro/에 시나리오가 없습니다. 작성 규칙은 .claude/rules/harness/maestro.md에 있습니다"
  flows=("$root/.maestro")
fi
result="$out_dir/e2e.json"
rm -f "$result"
start=$SECONDS

# --- 기기와 앱 -----------------------------------------------------------------

harness_destination
udid="${destination#id=}"
xcrun simctl boot "$udid" >/dev/null 2>&1 || true
xcrun simctl bootstatus "$udid" -b >/dev/null 2>&1 || harness_die "시뮬레이터 $destination_label을 켜지 못했습니다"

if [ "$build" = 1 ]; then
  "$here/build" || exit $?
fi
app="$(e2e_find_app "$derived_data" "$bundle_id")"
[ -n "$app" ] || harness_die "빌드된 앱($bundle_id)을 찾지 못했습니다. --no-build 없이 다시 실행하세요"
xcrun simctl install "$udid" "$app" || harness_die "앱을 시뮬레이터에 설치하지 못했습니다: $app"

# --- 실행 ---------------------------------------------------------------------

junit="$out_dir/e2e-junit.xml"
log="$out_dir/e2e.log"
artifacts="$out_dir/e2e"
rm -rf "$junit" "$artifacts"
args=(--device "$udid" test -e "APP_ID=$bundle_id" --format JUNIT --output "$junit" --test-output-dir "$artifacts" --no-ansi)
[ -z "$tag" ] || args+=(--include-tags "$tag")

recorder=""
if [ "$record" = 1 ]; then
  rm -f "$out_dir/e2e.mp4"
  xcrun simctl io "$udid" recordVideo --force "$out_dir/e2e.mp4" >/dev/null 2>&1 &
  recorder=$!
  sleep 1
fi
set +e
(cd "$root" && maestro "${args[@]}" "${flows[@]}") > "$log" 2>&1
code=$?
set -e
if [ -n "$recorder" ]; then
  kill -INT "$recorder" 2>/dev/null || true
  wait "$recorder" 2>/dev/null || true
fi
elapsed=$((SECONDS - start))

if [ ! -s "$junit" ]; then
  echo "✗ e2e · Maestro가 결과를 남기지 못했습니다 · ${elapsed}s" >&2
  grep -v '^\s*$' "$log" | tail -n 15 >&2
  exit 2
fi

e2e_junit_to_json "$junit" | jq --arg tag "$tag" --argjson code "$code" \
  '{ passed: ($code == 0 and (map(select(.status != "SUCCESS")) | length) == 0), tag: (if $tag == "" then null else $tag end), flows: . }' > "$result"

total="$(jq '.flows | length' "$result")"
failed="$(jq '[.flows[] | select(.status != "SUCCESS")] | length' "$result")"
video=""
[ "$record" = 0 ] || video=" · 영상 .harness/out/e2e.mp4"
if [ "$total" -eq 0 ]; then
  echo "✗ e2e · 돌린 시나리오가 없습니다${tag:+ (태그 $tag)} · ${elapsed}s"
  exit 1
fi
if jq -e .passed "$result" >/dev/null; then
  echo "✓ e2e · 통과 $total${tag:+ · 태그 $tag} · ${elapsed}s$video"
  exit 0
fi
echo "✗ e2e · 실패 $failed / $total${tag:+ · 태그 $tag} · ${elapsed}s$video"
jq -r --argjson max "$max_errors" '[.flows[] | select(.status != "SUCCESS")][:$max][]
  | "  \(.file): \(.failure // .status)"' "$result"
echo "  스크린샷·로그: .harness/out/e2e/ · 전체 출력: .harness/out/e2e.log"
exit 1
